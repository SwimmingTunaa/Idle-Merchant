<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/GlobalVariables.uss?fileID=7433441132597879392&amp;guid=a78c87095b9cb4d12a022ef277e19da6&amp;type=3" />
    <Style src="project://database/Assets/Scripts/UI/Panels/Guild%20Panel/MilestoneCard.uss?fileID=7433441132597879392&amp;guid=2f1f3d4b45c4e4f5382fd8eaedc21a90&amp;type=3#MilestoneCard" />
    <Style src="project://database/Assets/Scripts/UI/Components/ProgressBar.uss" />
    <ui:Template name="ProgressBar" src="project://database/Assets/Scripts/UI/Components/ProgressBar.uxml" />
    <ui:VisualElement name="milestone-card" class="milestone-card">
        <ui:VisualElement class="milestone-header">
            <ui:Label name="milestone-name" text="Milestone Name" class="milestone-name text-h3" style="margin: 0; padding: 0;" />
            <ui:Label name="milestone-checkmark" text="✓" class="milestone-checkmark" style="display: none;" />
        </ui:VisualElement>
        <ui:Label name="milestone-flavour" text="" class="milestone-flavour text-body" style="margin-top: 4px;" />
        <ui:Label name="milestone-description" text="Earn 1000 gold" class="milestone-description text-body" style="margin-top: 16px;" />
        <ui:Instance template="ProgressBar" name="progress-bar" />
    </ui:VisualElement>
</ui:UXML>
