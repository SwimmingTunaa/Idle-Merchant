.panel-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    position: absolute;
}

.book-container {
    width: 1400px;
    height: 900px;
    flex-direction: row;
    background-color: rgb(139, 90, 60);
    border-radius: 12px;
    padding: 40px;
    border-width: 8px;
    border-color: rgb(101, 67, 33);
}

.book-page {
    width: 640px;
    height: 100%;
    background-color: rgb(245, 235, 215);
    border-radius: 8px;
    padding: 32px;
    border-width: 2px;
    border-color: rgb(200, 180, 150);
    flex-direction: column;
}

.left-page {
    margin-right: 20px;
}

.right-page {
    margin-left: 20px;
}

.book-spine {
    width: 8px;
    height: 100%;
    background-color: rgb(80, 50, 30);
    border-radius: 2px;
}

/* ── Book Guild page (Guild_Page.uxml). Header = Cursor/Roster decorated title (inline font url in UXML). ── */

.guild-page-title {
    color: rgb(128, 75, 24);
}

/* Star sprites come from MainUI.uss .star / .star-filled / .star-empty (the book lives in MainUI);
   this only resizes them for the page. */
.guild-stars {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.guild-stars .star {
    width: 44px;
    height: 44px;
    margin: 0 4px;
}

.current-star-label {
    font-size: 30px;
    color: rgb(101, 67, 33);
    -unity-font-definition: var(--font-body);
    -unity-text-align: upper-center;
    margin: 0;
    padding: 0;
}

.next-star-label {
    font-size: 20px;
    color: rgb(155, 112, 72);
    -unity-font-definition: var(--font-body);
    -unity-text-align: upper-center;
    margin: 0 0 12px 0;
    padding: 0;
    flex-shrink: 0;
}

.milestones-scroll {
    flex-grow: 1;
}

.milestones-container {
    flex-direction: column;
}

.milestone-complete-label {
    font-size: 26px;
    color: var(--color-success-active);
    -unity-font-definition: var(--font-body);
    -unity-text-align: upper-center;
    margin-top: 40px;
}

.upgrade-scroll {
    flex-grow: 1;
}

.upgrade-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

/* GuildUpgradePanel sizes each card's TemplateContainer to 48.5% (two columns); the card fills it */
.upgrade-grid > TemplateContainer {
    margin-bottom: 16px;
}

.close-button {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 48px;
    height: 48px;
    background-color: rgb(200, 100, 100);
    border-width: 3px;
    border-color: rgb(150, 60, 60);
    border-radius: 24px;
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.close-button:hover {
    background-color: rgb(220, 120, 120);
    scale: 1.1;
}

.close-button:active {
    scale: 0.9;
}
