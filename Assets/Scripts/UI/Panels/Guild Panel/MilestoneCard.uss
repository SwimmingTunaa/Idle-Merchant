/* Book (Guild page) milestone card = the HUD tracker card (MilestoneTracker.uss .mt-*) on the book's
   card-torn.png at 3px. Two-class selectors so these win regardless of sheet import order. */

.mt-card.guild-ms {
    /* card-torn at 3px has a thinner chip band/shadow than the HUD sprite at 5px */
    padding: 14px 14px 18px 14px;
    margin-bottom: 12px;
}

.guild-ms .mt-card-name {
    font-size: 26px;
}

.guild-ms .mt-card-desc {
    font-size: 18px;
}

.guild-ms-flavour {
    font-size: 16px;
    white-space: normal;
    color: var(--color-text-muted);
    -unity-font-definition: var(--font-body);
    margin: 2px 0 0 0;
    padding: 0;
}
