/* Guild upgrade card — same torn-paper language as CursorUpgradeCard (card-torn.png 9-slice is inline in
   UpgradeCard.uxml). Bottom slot = exactly one of: buy button / "Requires N★" lock pill / Owned pill. */

.guild-card {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    padding: 14px;
}

.guild-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

/* wood-framed icon slot (same frame as the milestone cards) */
.guild-card-icon-frame {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    margin-right: 12px;
    padding: 4px;
    background-color: var(--color-box-bg);
    border-width: 3px;
    border-color: var(--color-border-dark);
    border-radius: var(--radius-sm);
}

.guild-card-icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.guild-card-name {
    flex-shrink: 1;
    font-size: 26px;
    white-space: normal;
    color: rgb(101, 67, 33);
    -unity-font-definition: var(--font-body);
    margin: 0;
    padding: 0;
}

.guild-card-desc {
    font-size: 18px;
    white-space: normal;
    color: rgb(155, 112, 72);
    -unity-font-definition: var(--font-body);
    margin: 0 0 12px 0;
    padding: 0;
}

/* pinned to the card bottom so a row of cards lines its buttons up */
.guild-card-slot {
    width: 100%;
    height: 52px;
    padding: 3px 10px 9px 10px;
    margin: auto 0 0 0;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.guild-card-lock-star {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-left: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

/* "Needs <previous rank>" (requiredUpgrade): longer than "Requires N★", so smaller and allowed two lines */
.guild-card-lock--prev .btn-label {
    font-size: var(--font-size-small);
    white-space: normal;
}

.guild-card-lock--prev .guild-card-lock-star {
    display: none;
}

.guild-card--locked {
    opacity: 0.85;
}

/* owned: green ink on the muted pill, like the CLAIMED stamp */
.btn-disabled.guild-card-owned {
    color: var(--color-success-active);
}

/* material cost row (built in code) sits just above the bottom slot; the slot drops its auto margin */
.guild-card .mat-row {
    margin: auto 0 6px 0;
}

.guild-card--mats .guild-card-slot {
    margin-top: 0;
}
