    <ui:VisualElement name="hire-panel" style="flex-grow: 0; flex-direction: row; justify-content: center; width: 100%; align-items: center; position: absolute; top: 2px; left: -1px;">
        <ui:Button text="&lt;" name="previous-button" class="hireButton btn-secondary" style="font-size: 48px; -unity-font-style: bold;" />
        <ui:VisualElement name="newspaper-stand" style="flex-grow: 0; justify-content: center; width: auto; height: auto; background-color: rgb(149, 99, 75); min-width: 800px; min-height: 750px; align-items: center; align-content: flex-start; align-self: flex-start;">
            <ui:TabView name="unit-type-tabs" style="width: 100%;">
                <ui:Tab label="Adventurers" name="adventurers-tab" />
                <ui:Tab label="Porters" name="porters-tab" />
            </ui:TabView>
            <ui:VisualElement name="text-container" style="flex-grow: 0; position: absolute; right: auto; top: auto; left: auto; bottom: auto; width: auto; justify-content: center; align-items: center;">
                <ui:Label text="Check Back In" name="empty-label" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Salmon%20Typewriter%209%20Regular.ttf?fileID=12800000&amp;guid=2c162277ddf0d4f9fa96298d0a4c7a84&amp;type=3#Salmon Typewriter 9 Regular&quot;); font-size: 32%;" />
                <ui:Label text="5:00" name="empty-timer" style="font-size: 32px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Salmon%20Typewriter%209%20Regular.ttf?fileID=12800000&amp;guid=2c162277ddf0d4f9fa96298d0a4c7a84&amp;type=3#Salmon Typewriter 9 Regular&quot;); -unity-font-style: normal;" />
            </ui:VisualElement>
            <ui:VisualElement name="layer-selector" style="flex-direction: row; justify-content: center; align-items: center; padding: 8px;">
                <ui:Button text="◀" name="layer-prev-button" class="btn-secondary" />
                <ui:Label text="Dungeon Level 1" name="layer-label" />
                <ui:Button text="▶" name="layer-next-button" class="btn-secondary" />
            </ui:VisualElement>
            <ui:VisualElement name="newspaper-container" style="flex-grow: 1; justify-content: flex-start; align-items: center; align-self: center; width: 100%; height: 750px;">
                <ui:Instance template="Candidate 1" name="TemplateCandidate" style="position: absolute; width: 700px; height: 750px; -unity-slice-scale: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="counter-container" style="flex-grow: 0; padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px; position: absolute; top: 768px; left: 637px; background-color: rgb(238, 189, 138); margin-bottom: 0; border-left-color: rgb(51, 50, 61); border-right-color: rgb(51, 50, 61); border-top-color: rgb(51, 50, 61); border-bottom-color: rgb(51, 50, 61); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px;">
                <ui:Label text="5/5" name="count" style="align-self: center; justify-content: center; align-items: center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Salmon%20Typewriter%209%20Regular.ttf?fileID=12800000&amp;guid=2c162277ddf0d4f9fa96298d0a4c7a84&amp;type=3#Salmon Typewriter 9 Regular&quot;); font-size: 32px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="&gt;" name="next-button" class="hireButton btn-secondary" style="font-size: 48px; -unity-font-style: bold;" />
