<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="Candidate 1" src="project://database/Assets/Scripts/UI/Panels/Hiring/Candidate.uxml?fileID=9197481963319205126&amp;guid=9b5bbf73db4954f9dbfac6d0ea03852f&amp;type=3#Candidate" />
