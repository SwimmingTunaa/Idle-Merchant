            <ui:VisualElement name="sprite-container" style="flex-grow: 2; width: 75%; height: 75px; min-width: 0; min-height: 0; flex-shrink: 0; justify-content: center; align-items: stretch; background-color: rgb(0, 191, 255); border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 8px; border-left-color: rgb(195, 137, 93); border-right-color: rgb(195, 137, 93); border-top-color: rgb(195, 137, 93); border-bottom-color: rgb(195, 137, 93);">
                <ui:VisualElement name="unit-container" style="flex-grow: 1; padding-top: 16px; padding-right: 16px; padding-bottom: 0; padding-left: 16px; height: auto;">
                    <ui:VisualElement name="unit-icon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/Customer/Villagers/MiniMiner.aseprite?fileID=-2042987769969361432&amp;guid=7f1bbf228ed0940f8bce6672bca17bc1&amp;type=3#Frame_1&quot;); -unity-background-scale-mode: scale-to-fit; width: auto; height: auto; flex-basis: auto; background-color: rgba(255, 255, 255, 0); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-right: 0; -unity-slice-left: -1; -unity-slice-top: -1; -unity-slice-right: -1; -unity-slice-bottom: -1; background-repeat: no-repeat no-repeat; flex-shrink: 1; justify-content: flex-end;" />
                </ui:VisualElement>
                <ui:VisualElement name="ground-container" style="flex-grow: 0; flex-direction: column; flex-shrink: 1;">
                    <ui:VisualElement name="grass" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/BigManJD/Platformer%20Tileset%20-%20Pixelart%20Grasslands/Sprites/Textures/Tiles/GrassTiles.png?fileID=1165701827&amp;guid=66453c654294d2045aa5eb98e5ea9f7d&amp;type=3#GrassTiles_95&quot;); -unity-background-scale-mode: scale-to-fit; width: auto; height: 48px; flex-basis: initial; background-color: rgba(255, 255, 255, 0); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-right: 0; background-size: 64px 64px; -unity-slice-left: 0; background-repeat: repeat repeat;" />
                </ui:VisualElement>
                <ui:VisualElement name="star-container" style="flex-grow: 0; position: absolute; top: -34px; left: -35px; bottom: 210px; right: 420px; align-self: flex-start; align-content: flex-start; align-items: center; justify-content: center; flex-direction: row; width: 80px; height: 80px; background-image: url(&quot;project://database/Assets/Sprites/UI/Hire%20Menu/adventurer%20badge%20Background.png?fileID=2800000&amp;guid=2e3cf9576aa94484baa390a68e8a8034&amp;type=3#adventurer badge Background&quot;); -unity-background-image-tint-color: rgb(130, 130, 130); flex-shrink: 0;">
                    <ui:VisualElement name="star-boarder" class="star" style="flex-grow: 1; flex-direction: row; justify-content: center; align-items: center; align-self: center; align-content: center; height: 100%; width: 100%; background-image: url(&quot;project://database/Assets/Sprites/UI/Hire%20Menu/adventurer%20badge%20Border.png?fileID=2800000&amp;guid=b8ba2a3fed1324a4db468921b4ae72b5&amp;type=3#adventurer badge Border&quot;);">
