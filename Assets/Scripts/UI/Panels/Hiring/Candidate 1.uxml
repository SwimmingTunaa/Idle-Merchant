    <ui:VisualElement name="newspaper" data-source-type="HiringCandidate, Assembly-CSharp" style="flex-grow: 0; background-color: rgba(255, 255, 255, 0); margin-left: 0; margin-right: 0; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; align-content: auto; align-items: center; align-self: center; width: 700px; margin-top: 0; margin-bottom: 0; height: 750px; background-image: url(&quot;project://database/Assets/Sprites/UI/Main%20UI/Paper/1.png?fileID=21300000&amp;guid=67b077c3e16c24cbba49d219cfacf6bf&amp;type=3#1&quot;); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 64; -unity-slice-top: 64; -unity-slice-right: 64; -unity-slice-bottom: 64; -unity-slice-scale: 1px; -unity-slice-type: sliced;">
        <ui:VisualElement name="header-section" style="flex-grow: 0; flex-direction: row; justify-content: center; align-self: center; align-content: auto; align-items: stretch; width: 100%; height: 60px; margin-top: 16px;">
            <ui:VisualElement name="empty-container" style="flex-grow: 1; align-content: auto; flex-direction: row; align-items: auto; justify-content: center;" />
