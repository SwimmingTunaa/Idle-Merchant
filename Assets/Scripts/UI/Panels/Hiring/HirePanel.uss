/* Hiring board — cork notice board (spec: HIRING_BOARD_DESIGN.md). Poster internals: Poster.uss.
   Also loaded by MainUI.uxml, so keep selectors scoped to the board. */

#hire-panel {
    -unity-font-definition: var(--font-body);
}

/* 700x820 root; every child is absolutely placed in root coordinates (the mock's numbers) */
.hire-board {
    width: 700px;
    height: 820px;
    align-self: flex-start;
}

.board-frame {
    position: absolute;
    left: 20px;
    top: 20px;
    width: 660px;
    height: 780px;
    background-color: rgb(90, 58, 34);
    border-width: 6px;
    border-color: rgb(43, 26, 18);
}

.cork {
    position: absolute;
    left: 50px;
    top: 76px;
    width: 600px;
    height: 694px;
    background-color: rgb(180, 136, 90);
    border-width: 4px;
    border-color: rgb(61, 38, 22);
}

.poster-layer {
    position: absolute;
    left: 70px;
    top: 96px;
    width: 560px;
    height: 654px;
}

/* Poster i (0 = front): left 60 + 4i, top 16 + 4i, tilt set inline by HireController */
.poster-card {
    position: absolute;
    width: 440px;
    height: 520px;
    transition-property: translate, rotate, opacity, scale;
    transition-duration: 0.28s, 0.28s, 0.28s, 0.08s;
}

/* the stamp lands: a quick squash (HireController adds it on the impact frame, drops it 90 ms later) */
.poster-card--punch {
    scale: 0.96;
}

/* stamp hand slam overlay: sized/positioned in code (poster width × SlamPerPosterWidth, BookStamp.AimAt) */
.hire-slam {
    position: absolute;
    display: none;
    -unity-background-scale-mode: stretch-to-fill;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Custom/Stamp.png?fileID=5564853175316236378&guid=6fdb63f54eb1349438d92a27ec084b83&type=3#Stamp_5");
}

/* Next = slide the front poster off (HireController adds +12° inline, waits 0.28 s, then sends it to the back);
   Previous = the back poster starts here (no transition) and slides in when the class drops next frame */
.poster--pulled,
.poster--arriving {
    translate: 160px 60px;
    opacity: 0;
    transition-timing-function: ease-in;
}

.poster--arriving,
.poster--snap {
    transition-duration: 0s;
}

/* Hire = tear off: lift, tilt, fade (HireController waits the same 0.35 s, then removes it) */
.poster-card--torn {
    translate: 0 -140px;
    opacity: 0;
    transition-property: translate, rotate, opacity;
    transition-duration: 0.35s;
}

.tack,
.tack:hover,
.tack:active {
    position: absolute;
    left: 50%;
    top: -10px;
    width: 22px;
    height: 22px;
    margin: 0 0 0 -11px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Sprites/UI/Hire%20Menu/tack.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: scale;
    transition-duration: 0.1s;
}

.tack:hover {
    scale: 1.15 1.15;
}

/* Left under the pile when a poster is hired; cleared on rebuild */
.poster-scrap {
    position: absolute;
    top: 0;
    width: 46px;
    height: 34px;
    background-image: url("project://database/Assets/Sprites/UI/Hire%20Menu/poster_scrap.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.poster-scrap .tack {
    top: -8px;
}

/* ── Tabs: the TabView headers as wooden signs ── */
#unit-type-tabs {
    position: absolute;
    left: 60px;
    top: 24px;
}

#unit-type-tabs .unity-tab-view__header-container {
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

#unit-type-tabs .unity-tab-view__content-container {
    display: none;
}

#unit-type-tabs .unity-tab__header {
    background-color: rgb(74, 50, 34);
    border-width: 4px;
    border-color: rgb(43, 26, 18);
    border-radius: 0;
    padding: 8px 22px;
    margin: 0 14px 0 0;
}

#unit-type-tabs .unity-tab__header:checked {
    background-color: rgb(107, 68, 38);
}

#unit-type-tabs .unity-tab__header-label {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
    font-size: 30px;
    color: rgb(184, 155, 122);
    margin: 0;
    padding: 0;
}

#unit-type-tabs .unity-tab__header:checked .unity-tab__header-label {
    color: rgb(243, 227, 195);
}

#unit-type-tabs .unity-tab__header-underline {
    display: none;
}

.nail {
    position: absolute;
    top: 4px;
    width: 8px;
    height: 8px;
    background-color: rgb(156, 156, 156);
    border-width: 2px;
    border-color: rgb(43, 26, 18);
    border-radius: 4px;
}

.nail--left { left: 4px; }
.nail--right { right: 4px; }

/* ── Prev / next arrows: wooden buttons on the cork either side of the pile ── */
.pile-arrow,
.pile-arrow:hover,
.pile-arrow:active {
    position: absolute;
    top: 340px;
    width: 44px;
    height: 64px;
    margin: 0;
    padding: 0;
    background-color: rgb(107, 68, 38);
    border-width: 4px;
    border-color: rgb(43, 26, 18);
    border-radius: 0;
    font-size: 30px;
    color: rgb(243, 227, 195);
    -unity-font-definition: var(--font-body);
    -unity-text-align: middle-center;
}

.pile-arrow:hover {
    background-color: rgb(125, 82, 48);
}

.pile-arrow--prev { left: 64px; }
.pile-arrow--next { right: 64px; }

/* ── Pinned paper notes on the cork's bottom edge: depth slip + restock note ── */
.note {
    position: absolute;
    top: 671px;
    align-items: center;
    background-color: rgb(239, 227, 196);
    border-width: 3px;
    border-color: rgb(169, 140, 92);
}

.depth-box {
    left: 125px;
    width: 210px;
    flex-direction: row;
    justify-content: center;
    padding: 26px 10px 14px 10px;
    rotate: -2deg;
}

.depth-arrow,
.depth-arrow:hover,
.depth-arrow:active {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 0 6px;
    font-size: 26px;
    color: rgb(107, 61, 30);
    -unity-font-definition: var(--font-body);
}

#layer-label {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
    font-size: 28px;
    color: rgb(43, 26, 18);
    margin: 0 6px;
    padding: 0;
}

.restock-note {
    left: 375px;
    width: 200px;
    padding: 26px 20px 18px 20px;
    rotate: 2deg;
}

.restock-note Label {
    font-size: 22px;
    color: rgb(74, 50, 32);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.note-line {
    flex-direction: row;
    align-items: flex-end;
    flex-wrap: wrap;
    justify-content: center;
}

.restock-note .note-time {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
    font-size: 26px;
    margin-left: 6px;
}
