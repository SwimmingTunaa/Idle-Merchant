#hire-panel {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Salmon%20Typewriter%209%20Regular.ttf?fileID=12800000&guid=2c162277ddf0d4f9fa96298d0a4c7a84&type=3#Salmon Typewriter 9 Regular");
}

#newspaper-stand {
    border-radius: 8px;
    border-width: 6px;
    border-color: rgb(101, 67, 33);
    padding: 24px;
}

#unit-type-tabs {
    margin-bottom: 16px;
    flex-grow: 1;
    flex-direction: row;
}

#unit-type-tabs > #unity-tab-view__header-container {
    background-color: rgba(101, 67, 33, 0.3);
    border-bottom-width: 2px;
    border-color: rgb(101, 67, 33);
    padding: 4px;
    flex-grow: 1;
}

#unit-type-tabs .unity-tab__header {
    background-color: rgba(250, 240, 220, 0.5);
    border-width: 2px;
    border-color: rgb(139, 90, 60);
    border-radius: 4px 4px 0 0;
    padding: 8px 16px;
    margin-right: 4px;
    color: rgb(90, 60, 40);
    font-size: 18px;
    transition-property: background-color;
    transition-duration: 0.1s;
    flex-grow: 1;
}

#unit-type-tabs .unity-tab__header:hover {
    background-color: rgba(250, 240, 220, 0.7);
}

#unit-type-tabs .unity-tab__header--checked {
    background-color: rgb(250, 240, 220);
    border-bottom-width: 0;
    color: rgb(50, 30, 10);
    flex-grow: 1;
    flex-direction: row;
}

#unit-type-tabs .unity-tab-view__content-viewport {
    flex-grow: 1;
    flex-direction: row;
}

#unit-type-tabs .unity-tab-view__header-container {
    flex-grow: 1;
    flex-direction: row;
}

#count {
    color: rgb(50, 30, 10);
}

#empty-label {
    color: rgb(50, 30, 10);
    font-size: 28px;
    margin-bottom: 8px;
}

#empty-timer {
    color: rgb(90, 60, 40);
}

.trait {
    margin: 2px;
    border-radius: 2px;
    transition-property: scale;
    transition-duration: 0.1s;
}

.trait:hover {
    scale: 1.05 1.05;
}

.trait-cursed {
    -unity-background-image-tint-color: rgb(200, 100, 100);
    color: rgb(100, 20, 20);
}

#mods-container {
    padding: 4px 8px;
}

.no-interact {
    pointer-events: none;
}
