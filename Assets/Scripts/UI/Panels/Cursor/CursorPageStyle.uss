/* Cursor page — status left, purchases right. Pixel look: BrightLinger at 1x/2x (16/32px),
   box-outline 9-slice cards, Button component (btn-*) for actions. */

.cursor-art {
    width: 96px;
    height: 96px;
    align-self: center;
    margin-bottom: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.cursor-stats {
    flex-direction: column;
}

.cursor-stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 10px;
    margin-bottom: 18px;
    border-bottom-width: 3px;
    border-bottom-color: rgb(200, 180, 150);
}

.cursor-stat-key {
    font-size: 32px;
    color: rgb(128, 75, 24);
    -unity-font-definition: var(--font-body);
}

.cursor-stat-value {
    font-size: 32px;
    color: rgb(101, 67, 33);
    -unity-font-definition: var(--font-body);
}

.cursor-stat-value--muted {
    color: rgb(170, 160, 140);
}

.upgrades-owned-label {
    font-size: 16px;
    color: rgb(155, 112, 72);
    margin-top: 20px;
    -unity-font-definition: var(--font-body);
}

.cursor-upgrade-list {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

/* ── upgrade card: pixel box-outline 9-slice frame (image + slices set from
   CursorUpgradePage code — the USS importer dropped the url() reference) ── */
.cursor-card {
    width: 48.5%;
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 16px;
    padding: 14px;
}

/* row 1: icon slot + name/level block */
.cursor-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.cursor-card-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    margin-right: 12px;
    border-width: 1px;
    border-color: rgba(101, 67, 33, 0.35);
}

.cursor-card--locked {
    opacity: 0.85;
}

.cursor-card-info {
    flex-grow: 1;
}

.cursor-card-name {
    font-size: 24px;
    white-space: normal;
    color: rgb(101, 67, 33);
    -unity-font-definition: var(--font-body);
}

.cursor-card-stat {
    margin-bottom: 12px;
    font-size: 24px;
    color: rgb(128, 75, 24);
    margin-top: 8px;
    -unity-font-definition: var(--font-body);
}

.cursor-card-substat {
    font-size: 16px;
    color: rgb(155, 112, 72);
    margin-top: 8px;
    -unity-font-definition: var(--font-body);
}

/* sizing overrides on top of the Button component classes — row 3, full card width */
.cursor-card-buy {
    width: 100%;
    height: 52px;
    padding: 3px 10px 9px 10px;
    margin-left: 0;
    margin-top: auto;
    flex-shrink: 0;
}

.cursor-card-lockpill {
    width: 100%;
    height: 52px;
    padding: 3px 10px 9px 10px;
    -unity-text-align: middle-center;
    margin-left: 0;
    margin-top: auto;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.cursor-page-title {
    color: rgb(128, 75, 24);
}

.lockpill-star {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-left: 4px;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}
