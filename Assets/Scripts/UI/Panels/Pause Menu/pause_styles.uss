/* ── Pause Menu — pixel-art pass ───────────────────────────────────────────
   Buttons now use the shared .btn-* system (Components/Button.uss).
   Board + header styling is token-driven here; layout one-offs stay inline. */

/* Dim the game behind the board so it reads as a modal. */
.pause-overlay {
    background-color: var(--color-bg-overlay);
}

/* No sprite — transparent board, just lays out the header + buttons. */
.pause-board {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    align-items: center;
    justify-content: center;
}

/* Title — NotJam pixel blackletter with a hard (blur-0) offset shadow. */
.pause-header {
    font-size: var(--font-size-heading-lg);
    color: var(--color-text-inverse);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
    -unity-text-align: middle-center;
}
