.roster-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.roster-container {
    width: 720px;
    min-height: 300px;
    max-height: 680px;
    background-color: rgb(238, 189, 138);
    border-width: 6px;
    border-color: rgb(101, 67, 33);
    border-radius: 8px;
    flex-direction: column;
}

.roster-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 14px 20px;
    background-color: rgb(195, 137, 93);
    border-bottom-width: 4px;
    border-color: rgb(101, 67, 33);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.roster-title {
    font-size: 26px;
    color: rgb(50, 30, 10);
    -unity-font-style: bold;
}

.close-button {
    width: 36px;
    height: 36px;
    font-size: 18px;
    background-color: rgb(180, 100, 60);
    color: rgb(250, 240, 220);
    border-width: 2px;
    border-color: rgb(101, 67, 33);
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.close-button:hover {
    background-color: rgb(210, 120, 80);
}

.close-button:active {
    background-color: rgb(155, 75, 35);
}

.roster-scroll {
    flex-grow: 1;
    padding: 12px 16px;
}

.roster-list {
    flex-direction: column;
    flex-grow: 1;
}

.adventurer-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(250, 230, 200);
    border-width: 3px;
    border-color: rgb(149, 99, 75);
    border-radius: 6px;
    padding: 10px 14px;
    margin-bottom: 8px;
}

.adventurer-name {
    font-size: 19px;
    color: rgb(50, 30, 10);
    width: 150px;
    flex-shrink: 0;
    overflow: hidden;
    -unity-text-overflow-position: end;
    -unity-text-align: middle-left;
}

.adventurer-rank {
    font-size: 14px;
    color: rgb(100, 60, 20);
    background-color: rgb(195, 137, 93);
    border-width: 2px;
    border-color: rgb(101, 67, 33);
    border-radius: 4px;
    padding: 2px 8px;
    margin-left: 8px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.xp-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    margin-right: 12px;
}

.xp-bar-bg {
    height: 12px;
    flex-grow: 1;
    background-color: rgb(175, 135, 95);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(101, 67, 33);
    overflow: hidden;
    margin-right: 8px;
}

.xp-bar-fill {
    height: 100%;
    background-color: rgb(70, 155, 70);
    border-radius: 4px;
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.xp-label {
    font-size: 13px;
    color: rgb(70, 45, 20);
    min-width: 110px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.promote-button {
    background-color: rgb(70, 150, 70);
    color: rgb(250, 240, 220);
    border-width: 2px;
    border-color: rgb(40, 100, 40);
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 15px;
    flex-shrink: 0;
    -unity-font-style: bold;
}

.promote-button:hover {
    background-color: rgb(90, 175, 90);
}

.promote-button:active {
    background-color: rgb(50, 120, 50);
}

.notification-badge {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 10px;
    height: 10px;
    background-color: rgb(240, 50, 50);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(180, 0, 0);
}

.roster-card {
    width: 160px;
    flex-direction: column;
    align-items: stretch;
    background-color: var(--color-bg-surface);
    border-width: 3px;
    border-color: var(--color-border-dark);
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    margin: 6px;
}

.roster-card:hover {
    background-color: var(--color-bg-light);
}

.roster-card--selected {
    border-color: var(--color-accent);
    border-width: 3px;
    background-color: var(--color-bg-light);
}

.card-sprite-container {
    width: 80px;
    height: 100px;
    border-width: 2px;
    border-color: var(--color-border-medium);
    overflow: hidden;
    align-self: center;
    margin-bottom: 4px;
}

.card-unit-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.card-name {
    font-size: var(--text-xs);
    -unity-text-align: middle-center;
    color: var(--color-text-primary);
    overflow: hidden;
    -unity-text-overflow-position: end;
    width: 100%;
    white-space: nowrap;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
}

.card-class {
    font-size: var(--text-sm);
    -unity-text-align: middle-center;
    color: var(--color-text-secondary);
    margin: 0;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.card-divider {
    height: 1px;
    background-color: var(--color-border-medium);
    margin-top: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.card-bar-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 2px;
}

.card-bar-label {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    flex-shrink: 0;
    min-width: 22px;
    -unity-text-align: middle-right;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.card-xp-bar-bg {
    height: 12px;
    flex-grow: 1;
    background-color: rgb(100, 70, 40);
    border-radius: 3px;
    overflow: hidden;
}

.card-xp-fill {
    height: 100%;
    background-color: rgb(60, 130, 210);
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
}

.card-info-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 1px;
}

.card-rank {
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-left: 4px;
}

.card-hp-bar-bg {
    height: 12px;
    flex-grow: 1;
    background-color: rgb(100, 70, 40);
    border-radius: 3px;
    overflow: hidden;
}

.card-hp-fill {
    height: 100%;
    background-color: rgb(180, 50, 50);
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
}

.detail-sprite-frame {
    width: 150px;
    height: 190px;
    flex-shrink: 0;
    border-width: 0;
    overflow: hidden;
    position: relative;
}

.detail-sprite {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.detail-ground {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 24px;
}

.rank-badge-overlay {
    position: absolute;
    top: -12px;
    left: -12px;
    width: 48px;
    height: 48px;
}

.stat-chip {
    background-color: var(--color-bg-light);
    border-width: 1px;
    border-color: var(--color-border-medium);
    border-radius: 4px;
    padding: 4px 8px;
    flex-direction: row;
    align-items: center;
}

.stat-chip-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
}

.stat-chip-value {
    font-size: var(--text-xs);
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

.detail-bar-bg {
    height: 14px;
    width: 100%;
    background-color: var(--color-bg-light);
    border-width: 1px;
    border-color: var(--color-border-medium);
    border-radius: 7px;
    overflow: hidden;
}

.detail-xp-fill {
    height: 100%;
    background-color: rgb(60, 130, 210);
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
}

.detail-hp-fill {
    height: 100%;
    background-color: rgb(180, 50, 50);
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
}

.trait-chip {
    background-color: var(--color-bg-surface);
    border-width: 1px;
    border-color: var(--color-border-medium);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.card-class-badge {
    background-color: var(--color-bg-surface);
    border-width: 1px;
    border-color: var(--color-border-medium);
    border-radius: var(--radius-pill);
    padding: 2px 8px;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.layer-section {
    flex-direction: column;
    margin-bottom: var(--space-md);
}

.layer-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 16px;
}

.layer-deco-line {
    width: 100px;
    height: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/17_16x16.png?fileID=2800000&guid=83b416998b1d04cac9d9a7d906b610ae&type=3#17_16x16");
}

.layer-deco-line--right {
    scale: -1 1;
}

.layer-name {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: var(--space-sm);
    margin-right: var(--space-sm);
    font-size: var(--font-size-body-lg);
    color: var(--color-text-primary);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

#page-title {
    color: var(--color-text-primary);
}

#roster-scroll .unity-scroll-view__vertical-scroller {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
}

.slot-row {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: flex-start;
}

.adv-slot-container {
    width: 95px;
    height: 95px;
    flex-shrink: 1;
    min-width: 0;
    margin-right: var(--space-md);
}

.slot-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    cursor: pointer;
}

.slot-frame {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: visible;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/inventory%20slot.png?fileID=21300000&guid=850d10acc4e4542a69dda03262628525&type=3#inventory slot");
}

.slot-wrapper:hover .slot-frame {
    scale: 1.03;
}

.slot-portrait-clip {
    position: absolute;
    top: 4px;
    left: 4px;
    right: 4px;
    bottom: 4px;
    overflow: hidden;
}

.slot-portrait {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    padding: 4px 4px 2px 4px;
    background-color: var(--primary-500);
}

.slot-bar-bg {
    height: 4px;
    background-color: var(--primary-900);
    overflow: hidden;
    margin-bottom: 2px;
}

.slot-xp-fill {
    height: 100%;
    background-color: var(--color-exp);
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
}

.slot-hp-fill {
    height: 100%;
    background-color: var(--color-destructive);
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
}

.slot-selector {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100px;
    height: 100px;
    translate: -50px -50px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Inscriptions/Dark/Selector-icons.png?fileID=1731615565123986282&guid=8e6332101472e45c58825f1b34a754da&type=3#selector-red");
    display: none;
}

.slot-selected .slot-selector {
    display: flex;
}

.slot-rank {
    position: absolute;
    top: -19px;
    right: -15px;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/Icons/ranks/Rank%201.png?fileID=2800000&guid=d825792e71a5342959a9c727f20b2749&type=3#Rank 1");
}

.slot-rank-label {
    font-size: var(--font-size-body-md);
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    padding-bottom: 4px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
    padding-left: 2px;
}

.empty-slot {
    width: 95px;
    height: 95px;
    flex-shrink: 1;
    min-width: 0;
    margin-right: var(--space-md);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/adv-slot.png?fileID=2800000&guid=7dce2c3279a3a4ce592395994f6a87ab&type=3#adv-slot");
}

.empty-slot:hover {
    scale: 1.03;
}

.empty-slot-icon {
    font-size: 32px;
    color: var(--primary-500);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.mod {
    margin: 0;
    padding: 0;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
    font-size: 16px;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
}

/* ════════════════════════════════════════════════════════════════════════════
   Roster detail — RIGHT PAGE. Mirrors Figma node 112:1017 exactly.
   Font   = Font/Body (BrightLinger).      Sizes  = Body/* tokens (px verbatim).
   Colour = Text/* tokens.                 Spacing = Spacing/* tokens.
   ════════════════════════════════════════════════════════════════════════════ */

/* Reset Unity's built-in (theme) margins. Bare * = specificity 0, so every
   explicit class/inline margin below (the gap-as-margin spacing) overrides it.
   NOTE: do NOT raise this to `#right-content *` — an id selector (1,0,0) would
   outrank the .class margins (0,1,0) and wipe out all the gaps. */
* {
    margin: 0;
}

/* All detail text uses Font/Body = BrightLinger. */
#detail-container Label {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

#detail-container {
    flex-direction: column;
    flex-grow: 1;
}

/* ── Top overlap region (sprite-container @x210 + class group @x48) — full page width ── */
.detail-top {                /* sprite-container region (242); page gap-8 added on next child */
    height: 242px;
    flex-shrink: 0;
    position: relative;
}

/* sprite-container 210×242 @ x210 */
.sprite-container {
    position: absolute;
    left: 210px;
    top: 0;
    width: 210px;
    height: 250px;
}
.deco-diamond-big {
    position: absolute;
    left: 0;
    top: 0;
    width: 210px;
    height: 210px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/Diamond%20Big.png?fileID=2800000&guid=914b27bc6ad9648eb814957fc8e2c047&type=3#Diamond Big");
}
.slot {
    position: absolute;
    left: 0;
    top: 0;
    width: 210px;
    height: 210px;
}
/* adv-sprite-big 146×124 @ (32,43) within the slot */
.adv-sprite-big {
    position: absolute;
    left: 32px;
    top: 43px;
    width: 146px;
    height: 124px;
    -unity-background-scale-mode: scale-to-fit;
}
/* item-name-container 400×80 @ (-95,170) */
.item-name-container {       /* centered over the slot; banner + faked shadow are layers */
    position: absolute;
    left: -95px;
    top: 170px;
    width: 400px;
    height: 80px;
    align-items: center;
    justify-content: center;
    padding-bottom: 16px;
}
/* Faked drop-shadow (Figma shadow 0 4px 0 #b3916f): tinted banner copy, 4px lower, behind. */
.name-shadow {
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    bottom: -4px;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-title-banner.png?fileID=2800000&guid=992d1ea8d5ec74d89b5301bb26534a78&type=3#deco-title-banner");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: var(--color-box-border);
}
.name-fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-title-banner.png?fileID=2800000&guid=992d1ea8d5ec74d89b5301bb26534a78&type=3#deco-title-banner");
    -unity-background-scale-mode: scale-and-crop;
}
.name-text-container {       /* Figma "Container" 241×64 */
    width: 241px;
    height: 64px;
    align-items: center;
    justify-content: center;
}
#detail-name {
    font-size: 48px;                     /* Body/2XL */
    color: var(--color-text-primary);    /* Text/Primary */
    -unity-text-align: middle-center;
}
/* epithet 202×49 @ (215,220) — i.e. (5,220) inside sprite-container */
/* epithet — absolute wrapper holds a 2.6° rotated banner (Figma rotate-[2.6deg]) */
.epithet-wrapper {
    position: absolute;
    left: 3px;
    top: 220px;
    width: 202px;
    height: 49px;
    align-items: center;
    justify-content: center;
}
.epithet-rotate {
    rotate: 2.6deg;
    align-items: center;
    justify-content: center;
}
.epithet {                   /* inner banner box 200×40; banner + faked shadow are layers */
    width: 200px;
    height: 40px;
    align-items: center;
    justify-content: center;
}
.epithet-shadow {
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    bottom: -4px;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Custom/epithet.png?fileID=-7657284972936839921&guid=b52c24f2512b34c459b9c716530f0692&type=3#epithet_0");
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 2;
    -unity-slice-bottom: 2;
    -unity-slice-scale: 2px;
    -unity-background-image-tint-color: var(--color-box-border);
}
.epithet-fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Custom/epithet.png?fileID=-7657284972936839921&guid=b52c24f2512b34c459b9c716530f0692&type=3#epithet_0");
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 2;
    -unity-slice-bottom: 2;
    -unity-slice-scale: 2px;
}
#detail-epithet {
    font-size: 24px;                     /* Body/MD */
    color: var(--color-text-strong);     /* Text/Strong */
    -unity-text-align: middle-center;
}

/* ── Class group (Group 1) 191×80 @ (48,1) ── */
.class-group {
    position: absolute;
    left: 48px;
    top: 1px;
    width: 191px;
    height: 80px;
}
.class-circle {              /* Group 2 — circle + job icon, 80×80 @ x0 */
    position: absolute;
    left: 0;
    top: 0;
    width: 80px;
    height: 80px;
}
.circle-outline {            /* 64×64 @ (8,11) within Group 2 */
    position: absolute;
    left: 8px;
    top: 11px;
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Custom/circle-outline%2016x16.png?fileID=-5501662205497309343&guid=f2fa623a4e5dc47679de73bd62d02cea&type=3#circle-outline 16x16_0");
}
.job-icon {                  /* 80×80 @ x0 */
    position: absolute;
    left: 0;
    top: 0;
    width: 80px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Custom/job_icons_singleoutline.png?fileID=1811167131&guid=98b2f1c9237cb4662958fb3b4cdf2261&type=3#warrior");
}
.class-frame {               /* class-name container — hugs content, @ (61,20) */
    position: absolute;
    left: 61px;
    top: 20px;
    align-items: center;
    justify-content: center;
    padding-left: 32px;      /* Spacing/XL */
    padding-right: 32px;     /* Spacing/XL */
    padding-top: 16px;       /* Spacing/MD */
    padding-bottom: 16px;    /* Spacing/MD */
    background-color: var(--color-box-bg);      /* inner background #D7B594 */
    border-width: 5px;
    border-color: var(--color-box-border);      /* sprite border #B3916F */
    border-radius: 0;
}
#detail-class {
    font-size: 24px;                     /* Body/MD */
    color: var(--color-text-primary);    /* Text/Primary */
    -unity-text-align: middle-center;
}

/* ── Progress Bars 520×80 — rank shield + EXP bar (+ hidden promote) ── */
.progress-bars {
    margin-left: 55px;
    margin-top: 8px;                     /* Spacing/SM — page gap (mimics gap-8) */
    flex-direction: column;
    flex-shrink: 0;
}
.level-rank {
    flex-direction: row;
    align-items: center;
    height: 80px;
}
.rank {                      /* 80×80 shield */
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/Icons/ranks/Rank%201.png?fileID=2800000&guid=d825792e71a5342959a9c727f20b2749&type=3#Rank 1");
}
#detail-rank-number {
    font-size: 24px;                     /* Body/MD */
    color: var(--color-text-inverse);
    -unity-text-align: middle-center;
    padding-bottom: 4px;
}
.progress-bar-label {        /* exp column, starts 8px (Spacing/SM) after the rank */
    flex-grow: 1;
    margin-left: 8px;
    flex-direction: column;
    justify-content: center;
}
.exp-head {                              /* Figma "Label": left-grouped, gap 8 */
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;                  /* Spacing/XS */
}
.exp-label {
    font-size: 16px;                     /* Body/SM */
    color: var(--color-text-primary);    /* Text/Primary */
}
#detail-rank-name {                      /* rank tier (e.g. "Wood") in the EXP row */
    font-size: 16px;                     /* Body/SM */
    color: var(--color-text-primary);  /* Text/Primary */
}
#xp-label-value {
    font-size: 16px;                     /* Body/SM */
    color: var(--color-text-secondary);  /* Text/Secondary */
    margin-left: 8px;                    /* Spacing/SM — gap before the value */
}
/* dungeon layer name, pinned to the top-right of the page */
.detail-layer {
    position: absolute;
    top: 4px;
    right: 4px;
    font-size: 16px;                     /* Body/SM */
    color: var(--color-text-secondary);  /* Text/Secondary */
    -unity-text-align: middle-right;
}
.exp-bar-bg {
    height: 12px;
    background-color: var(--blue-200);   /* Blue/200 track */
    overflow: hidden;
}
#detail-xp-fill {
    height: 100%;
    width: 0;
    background-color: var(--color-exp);  /* color-exp / Blue/500 */
    transition-property: width;
    transition-duration: 0.3s;
}

/* ── Section (Stats + Traits & Skills) ── */
.section {                               /* one Section wraps both groups; page gap-8 above */
    margin-left: 55px;
    margin-top: 8px;                     /* Spacing/SM — page gap (mimics gap-8) */
    flex-shrink: 0;
}
.section-group {                         /* Stats group / Traits & Skills group */
    flex-shrink: 0;
}
.section-group--traits {
    margin-top: 16px;                    /* Spacing/MD — gap between the two groups */
}
.heading {
    flex-direction: row;
    align-items: center;
    height: 18px;
    margin-bottom: 8px;                  /* heading 18 → badges @26 */
}
.heading-deco {
    flex-grow: 1;
    flex-basis: 0;
    height: 10px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/14_16x16.png?fileID=-3802367633072120375&guid=10da1518798c0455f8498d53948aa2a1&type=3#14_16x16_0");
}
.heading-deco--right {
    scale: -1 1;
}
.heading-title {
    flex-shrink: 0;
    margin-left: 8px;
    margin-right: 8px;
    font-size: 24px;                     /* Body/MD */
    color: var(--color-text-primary);    /* Text/Primary */
    -unity-text-align: middle-center;
}
.badge-row {
    flex-direction: row;
    height: 64px;
}
.badge {                     /* 168×64, gap 8 (Spacing/SM) */
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 4px;
    margin-right: 4px;
    align-items: center;
    justify-content: center;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/box-splice.png?fileID=1142012838051687708&guid=7431fc87a504d4dc29fd217299608c7f&type=3#box-splice_0");
    -unity-slice-left: 16;
    -unity-slice-right: 16;
    -unity-slice-top: 8;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}
.badge-label {
    font-size: 16px;                     /* Body/SM */
    color: var(--color-text-secondary);  /* Text/Secondary */
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}
.badge-value {
    font-size: 40px;                     /* Body/XL (stat values) */
    color: var(--color-text-secondary);  /* Text/Secondary */
    -unity-text-align: middle-center;
}
.badge-value--trait {
    font-size: 32px;                     /* Body/LG */
    color: var(--color-text-success);    /* Text/Success */
}
.badge-value--skill {
    font-size: 32px;                     /* Body/LG */
    color: var(--color-text-info);       /* Text/Info */
}

/* ── description-container 520×84 ── */
.description-container {
    margin-left: 55px;
    margin-top: 8px;                     /* Section ends 534 → desc @542 */
    height: 84px;
    flex-shrink: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/12_2.png?fileID=-7954138311804534128&guid=847c65b70758a4b6f849ec8a43ec2e9b&type=3#12_2_0");
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-scale: 5px;
}
#detail-description {
    font-size: 16px;                     /* Body/SM */
    color: var(--color-text-primary);    /* Text/Primary */
    white-space: normal;
}

/* ── Frame 6 520×56 — Dismiss button, right-aligned ── */
.frame-6 {
    margin-left: 55px;
    margin-top: 8px;                     /* desc ends 626 → button @634 */
    height: 56px;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}
