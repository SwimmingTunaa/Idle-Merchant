/* ── Roster Panel ─────────────────────────────────── */

/* Full-screen transparent backdrop — centres the container */
.roster-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

/* Visible card */
.roster-container {
    width: 720px;
    min-height: 300px;
    max-height: 680px;
    background-color: rgb(238, 189, 138);
    border-width: 6px;
    border-color: rgb(101, 67, 33);
    border-radius: 8px;
    flex-direction: column;
}

/* ── Header ──────────────────────────────────────── */

.roster-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 14px 20px;
    background-color: rgb(195, 137, 93);
    border-bottom-width: 4px;
    border-color: rgb(101, 67, 33);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.roster-title {
    font-size: 26px;
    color: rgb(50, 30, 10);
    -unity-font-style: bold;
}

.close-button {
    width: 36px;
    height: 36px;
    font-size: 18px;
    background-color: rgb(180, 100, 60);
    color: rgb(250, 240, 220);
    border-width: 2px;
    border-color: rgb(101, 67, 33);
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.close-button:hover {
    background-color: rgb(210, 120, 80);
}

.close-button:active {
    background-color: rgb(155, 75, 35);
}

/* ── Scroll / list ───────────────────────────────── */

.roster-scroll {
    flex-grow: 1;
    padding: 12px 16px;
}

.roster-list {
    flex-direction: column;
    flex-grow: 1;
}

/* ── Adventurer card ─────────────────────────────── */

.adventurer-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(250, 230, 200);
    border-width: 3px;
    border-color: rgb(149, 99, 75);
    border-radius: 6px;
    padding: 10px 14px;
    margin-bottom: 8px;
}

.adventurer-name {
    font-size: 19px;
    color: rgb(50, 30, 10);
    width: 150px;
    flex-shrink: 0;
    overflow: hidden;
    -unity-text-overflow-position: end;
    -unity-text-align: middle-left;
}

.adventurer-rank {
    font-size: 14px;
    color: rgb(100, 60, 20);
    background-color: rgb(195, 137, 93);
    border-width: 2px;
    border-color: rgb(101, 67, 33);
    border-radius: 4px;
    padding: 2px 8px;
    margin-left: 8px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

/* ── XP row ──────────────────────────────────────── */

.xp-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    margin-right: 12px;
}

.xp-bar-bg {
    height: 12px;
    flex-grow: 1;
    background-color: rgb(175, 135, 95);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(101, 67, 33);
    overflow: hidden;
    margin-right: 8px;
}

.xp-bar-fill {
    height: 100%;
    background-color: rgb(70, 155, 70);
    border-radius: 4px;
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.xp-label {
    font-size: 13px;
    color: rgb(70, 45, 20);
    min-width: 110px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

/* ── Promote button ──────────────────────────────── */

.promote-button {
    background-color: rgb(70, 150, 70);
    color: rgb(250, 240, 220);
    border-width: 2px;
    border-color: rgb(40, 100, 40);
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 15px;
    flex-shrink: 0;
    -unity-font-style: bold;
}

.promote-button:hover {
    background-color: rgb(90, 175, 90);
}

.promote-button:active {
    background-color: rgb(50, 120, 50);
}

/* ── HUD notification dot on units-button ─────────── */

.notification-badge {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 10px;
    height: 10px;
    background-color: rgb(240, 50, 50);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(180, 0, 0);
}
