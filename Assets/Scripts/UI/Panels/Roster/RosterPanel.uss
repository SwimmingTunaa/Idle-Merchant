.roster-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.roster-container {
    width: 720px;
    min-height: 300px;
    max-height: 680px;
    background-color: rgb(238, 189, 138);
    border-width: 6px;
    border-color: rgb(101, 67, 33);
    border-radius: 8px;
    flex-direction: column;
}

.roster-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 14px 20px;
    background-color: rgb(195, 137, 93);
    border-bottom-width: 4px;
    border-color: rgb(101, 67, 33);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.roster-title {
    font-size: 26px;
    color: rgb(50, 30, 10);
    -unity-font-style: bold;
}

.close-button {
    width: 36px;
    height: 36px;
    font-size: 18px;
    background-color: rgb(180, 100, 60);
    color: rgb(250, 240, 220);
    border-width: 2px;
    border-color: rgb(101, 67, 33);
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.close-button:hover {
    background-color: rgb(210, 120, 80);
}

.close-button:active {
    background-color: rgb(155, 75, 35);
}

.roster-scroll {
    flex-grow: 1;
    padding: 12px 16px;
}

.roster-list {
    flex-direction: column;
    flex-grow: 1;
}

.adventurer-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(250, 230, 200);
    border-width: 3px;
    border-color: rgb(149, 99, 75);
    border-radius: 6px;
    padding: 10px 14px;
    margin-bottom: 8px;
}

.adventurer-name {
    font-size: 19px;
    color: rgb(50, 30, 10);
    width: 150px;
    flex-shrink: 0;
    overflow: hidden;
    -unity-text-overflow-position: end;
    -unity-text-align: middle-left;
}

.adventurer-rank {
    font-size: 14px;
    color: rgb(100, 60, 20);
    background-color: rgb(195, 137, 93);
    border-width: 2px;
    border-color: rgb(101, 67, 33);
    border-radius: 4px;
    padding: 2px 8px;
    margin-left: 8px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.xp-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    margin-right: 12px;
}

.xp-bar-bg {
    height: 12px;
    flex-grow: 1;
    background-color: rgb(175, 135, 95);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(101, 67, 33);
    overflow: hidden;
    margin-right: 8px;
}

.xp-bar-fill {
    height: 100%;
    background-color: rgb(70, 155, 70);
    border-radius: 4px;
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.xp-label {
    font-size: 13px;
    color: rgb(70, 45, 20);
    min-width: 110px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.promote-button {
    background-color: rgb(70, 150, 70);
    color: rgb(250, 240, 220);
    border-width: 2px;
    border-color: rgb(40, 100, 40);
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 15px;
    flex-shrink: 0;
    -unity-font-style: bold;
}

.promote-button:hover {
    background-color: rgb(90, 175, 90);
}

.promote-button:active {
    background-color: rgb(50, 120, 50);
}

.notification-badge {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 10px;
    height: 10px;
    background-color: rgb(240, 50, 50);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(180, 0, 0);
}

.roster-card {
    width: 160px;
    flex-direction: column;
    align-items: stretch;
    background-color: var(--color-bg-surface);
    border-width: 3px;
    border-color: var(--color-border-dark);
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    margin: 6px;
}

.roster-card:hover {
    background-color: var(--color-bg-light);
}

.roster-card--selected {
    border-color: var(--color-accent);
    border-width: 3px;
    background-color: var(--color-bg-light);
}

.card-sprite-container {
    width: 80px;
    height: 100px;
    border-width: 2px;
    border-color: var(--color-border-medium);
    overflow: hidden;
    align-self: center;
    margin-bottom: 4px;
}

.card-unit-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.card-name {
    font-size: var(--text-xs);
    -unity-text-align: middle-center;
    color: var(--color-text-primary);
    overflow: hidden;
    -unity-text-overflow-position: end;
    width: 100%;
    white-space: nowrap;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
}

.card-class {
    font-size: var(--text-sm);
    -unity-text-align: middle-center;
    color: var(--color-text-secondary);
    margin: 0;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.card-divider {
    height: 1px;
    background-color: var(--color-border-medium);
    margin-top: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.card-bar-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 2px;
}

.card-bar-label {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    flex-shrink: 0;
    min-width: 22px;
    -unity-text-align: middle-right;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.card-xp-bar-bg {
    height: 12px;
    flex-grow: 1;
    background-color: rgb(100, 70, 40);
    border-radius: 3px;
    overflow: hidden;
}

.card-xp-fill {
    height: 100%;
    background-color: rgb(60, 130, 210);
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
}

.card-info-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 1px;
}

.card-rank {
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-left: 4px;
}

.card-hp-bar-bg {
    height: 12px;
    flex-grow: 1;
    background-color: rgb(100, 70, 40);
    border-radius: 3px;
    overflow: hidden;
}

.card-hp-fill {
    height: 100%;
    background-color: rgb(180, 50, 50);
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
}

.detail-sprite-frame {
    width: 150px;
    height: 190px;
    flex-shrink: 0;
    border-width: 0;
    overflow: hidden;
    position: relative;
}

.detail-sprite {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.detail-ground {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 24px;
}

.rank-badge-overlay {
    position: absolute;
    top: -12px;
    left: -12px;
    width: 48px;
    height: 48px;
}

.stat-chip {
    background-color: var(--color-bg-light);
    border-width: 1px;
    border-color: var(--color-border-medium);
    border-radius: 4px;
    padding: 4px 8px;
    flex-direction: row;
    align-items: center;
}

.stat-chip-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
}

.stat-chip-value {
    font-size: var(--text-xs);
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

.detail-bar-bg {
    height: 14px;
    width: 100%;
    background-color: var(--color-bg-light);
    border-width: 1px;
    border-color: var(--color-border-medium);
    border-radius: 7px;
    overflow: hidden;
}

.detail-xp-fill {
    height: 100%;
    background-color: rgb(60, 130, 210);
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
}

.detail-hp-fill {
    height: 100%;
    background-color: rgb(180, 50, 50);
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
}

.trait-chip {
    background-color: var(--color-bg-surface);
    border-width: 1px;
    border-color: var(--color-border-medium);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.card-class-badge {
    background-color: var(--color-bg-surface);
    border-width: 1px;
    border-color: var(--color-border-medium);
    border-radius: var(--radius-pill);
    padding: 2px 8px;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.layer-section {
    flex-direction: column;
    margin-bottom: var(--space-md);
}

.layer-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 16px;
}

.layer-deco-line {
    width: 100px;
    height: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/17_16x16.png?fileID=2800000&guid=83b416998b1d04cac9d9a7d906b610ae&type=3#17_16x16");
}

.layer-deco-line--right {
    scale: -1 1;
}

.layer-name {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: var(--space-sm);
    margin-right: var(--space-sm);
    font-size: var(--font-size-body-lg);
    color: var(--color-text-primary);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

#roster-scroll .unity-scroll-view__vertical-scroller {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
}

.slot-row {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: flex-start;
}

.adv-slot-container {
    width: 95px;
    height: 95px;
    flex-shrink: 1;
    min-width: 0;
    margin-right: var(--space-md);
}

.slot-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    cursor: pointer;
}

.slot-frame {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: visible;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/inventory%20slot.png?fileID=21300000&guid=850d10acc4e4542a69dda03262628525&type=3#inventory slot");
}

.slot-wrapper:hover .slot-frame {
    scale: 1.03;
}

.slot-portrait-clip {
    position: absolute;
    top: 4px;
    left: 4px;
    right: 4px;
    bottom: 4px;
    overflow: hidden;
}

.slot-portrait {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    padding: 4px 4px 2px 4px;
    background-color: var(--primary-500);
}

.slot-bar-bg {
    height: 4px;
    background-color: var(--primary-900);
    overflow: hidden;
    margin-bottom: 2px;
}

.slot-xp-fill {
    height: 100%;
    background-color: var(--color-exp);
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
}

.slot-hp-fill {
    height: 100%;
    background-color: var(--color-destructive);
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
}

.slot-selector {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100px;
    height: 100px;
    translate: -50px -50px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Inscriptions/Dark/Selector-icons.png?fileID=1731615565123986282&guid=8e6332101472e45c58825f1b34a754da&type=3#selector-red");
    display: none;
}

.slot-selected .slot-selector {
    display: flex;
}

.slot-rank {
    position: absolute;
    top: -19px;
    right: -15px;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/Icons/ranks/Rank%201.png?fileID=2800000&guid=d825792e71a5342959a9c727f20b2749&type=3#Rank 1");
}

.slot-rank-label {
    font-size: var(--font-size-body-md);
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    padding-bottom: 4px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
    padding-left: 2px;
}

.empty-slot {
    width: 95px;
    height: 95px;
    flex-shrink: 1;
    min-width: 0;
    margin-right: var(--space-md);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/adv-slot.png?fileID=2800000&guid=7dce2c3279a3a4ce592395994f6a87ab&type=3#adv-slot");
}

.empty-slot:hover {
    scale: 1.03;
}

.empty-slot-icon {
    font-size: 32px;
    color: var(--primary-500);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.mod {
    margin: 0;
    padding: 0;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
    font-size: 16px;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
}
