<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="AdventurerSlot" src="project://database/Assets/Scripts/UI/Panels/Roster/AdventurerSlot.uxml?fileID=9197481963319205126&amp;guid=6eba097cdc81c406083b05c2e13f2368&amp;type=3#AdventurerSlot" />
    <Style src="project://database/Assets/Scripts/UI/GlobalVariables.uss?fileID=7433441132597879392&amp;guid=a78c87095b9cb4d12a022ef277e19da6&amp;type=3#GlobalVariables" />
    <Style src="project://database/Assets/Scripts/UI/Panels/Roster/RosterPanel.uss?fileID=7433441132597879392&amp;guid=fcda90a85139941bea862f290df11926&amp;type=3#RosterPanel" />
    <Style src="project://database/Assets/Scripts/UI/Panels/Inventory/InventoryPanel.uss?fileID=7433441132597879392&amp;guid=74ac0a55dbd8b4dbc9772a233525715e&amp;type=3#InventoryPanel" />
    <Style src="project://database/Assets/Scripts/UI/Components/Button.uss?fileID=7433441132597879392&amp;guid=ca85a2c69b8914d29a2cd1cd9d9d5556&amp;type=3#Button" />
    <ui:VisualElement name="page-root" style="flex-direction: row; flex-grow: 1;">
        <ui:VisualElement name="left-content" style="flex-grow: 1; flex-basis: 0; overflow: hidden; flex-direction: column; padding: 12px; padding-top: 0; padding-right: 55px; padding-bottom: 0; padding-left: 0;">
            <ui:VisualElement name="book-header" style="flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; margin-bottom: 12px;">
                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center;">
                    <ui:VisualElement name="deco-swirl 1" style="width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-swirl.PNG?fileID=2800000&amp;guid=7f697000926e54b27b639ae0ee9a7656&amp;type=3#deco-swirl&quot;);" />
                    <ui:Label name="page-title" text="Roster" style="font-size: 52px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&amp;guid=bf0206d6060cb4ed89e74ae40ea01e22&amp;type=3#NotJamBlkltr13&quot;); -unity-text-align: middle-center; margin-left: 16px; margin-right: 16px;" />
                    <ui:VisualElement name="deco-swirl 2" style="width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-swirl-right.PNG?fileID=2800000&amp;guid=ee8e6e92ee45b4ebeaa0699d75dc2999&amp;type=3#deco-swirl-right&quot;);" />
                </ui:VisualElement>
                <ui:VisualElement name="deco-underline 1" style="width: 415px; height: 40px; -unity-background-scale-mode: stretch-to-fill; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-underline.png?fileID=2800000&amp;guid=0ae5cfc3aea744660aaf241e3f2c6ea9&amp;type=3#deco-underline&quot;); margin-top: 8px;" />
            </ui:VisualElement>
            <ui:ScrollView name="roster-scroll" mode="Vertical" style="flex-grow: 1;">
                <ui:VisualElement name="layers-container" style="flex-direction: column; padding: 0; padding-top: 20px;">
                    <ui:VisualElement class="layer-section">
                        <ui:VisualElement class="layer-header">
                            <ui:VisualElement class="layer-deco-line" />
                            <ui:Label text="Abandoned Mines" class="layer-name" />
                            <ui:VisualElement class="layer-deco-line layer-deco-line--right" />
                        </ui:VisualElement>
                        <ui:VisualElement class="slot-row">
                            <ui:Instance template="AdventurerSlot" class="adv-slot-container" />
                            <ui:Instance template="AdventurerSlot" class="adv-slot-container" />
                            <ui:Instance template="AdventurerSlot" class="adv-slot-container" />
                            <ui:VisualElement class="empty-slot">
                                <ui:Label text="+" name="Label" class="empty-slot-icon" />
                            </ui:VisualElement>
                            <ui:Instance template="AdventurerSlot" class="adv-slot-container" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="layer-section">
                        <ui:VisualElement class="layer-header">
                            <ui:VisualElement class="layer-deco-line" />
                            <ui:Label text="Deep Caverns" class="layer-name" />
                            <ui:VisualElement class="layer-deco-line layer-deco-line--right" />
                        </ui:VisualElement>
                        <ui:VisualElement class="slot-row">
                            <ui:Instance template="AdventurerSlot" class="adv-slot-container" />
                            <ui:Instance template="AdventurerSlot" class="adv-slot-container" />
                            <ui:VisualElement class="empty-slot">
                                <ui:Label text="+" class="empty-slot-icon" />
                            </ui:VisualElement>
                            <ui:VisualElement class="empty-slot">
                                <ui:Label text="+" class="empty-slot-icon" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="layer-section">
                        <ui:VisualElement class="layer-header">
                            <ui:VisualElement class="layer-deco-line" />
                            <ui:Label text="Crystal Hollows" class="layer-name" />
                            <ui:VisualElement class="layer-deco-line layer-deco-line--right" />
                        </ui:VisualElement>
                        <ui:VisualElement class="slot-row">
                            <ui:Instance template="AdventurerSlot" class="adv-slot-container" />
                            <ui:VisualElement class="empty-slot">
                                <ui:Label text="+" class="empty-slot-icon" />
                            </ui:VisualElement>
                            <ui:VisualElement class="empty-slot">
                                <ui:Label text="+" class="empty-slot-icon" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="layer-section">
                        <ui:VisualElement class="layer-header">
                            <ui:VisualElement class="layer-deco-line" />
                            <ui:Label text="Cursed Crypts" class="layer-name" />
                            <ui:VisualElement class="layer-deco-line layer-deco-line--right" />
                        </ui:VisualElement>
                        <ui:VisualElement class="slot-row">
                            <ui:VisualElement class="empty-slot">
                                <ui:Label text="+" class="empty-slot-icon" />
                            </ui:VisualElement>
                            <ui:VisualElement class="empty-slot">
                                <ui:Label text="+" class="empty-slot-icon" />
                            </ui:VisualElement>
                            <ui:VisualElement class="empty-slot">
                                <ui:Label text="+" class="empty-slot-icon" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="layer-section">
                        <ui:VisualElement class="layer-header">
                            <ui:VisualElement class="layer-deco-line" />
                            <ui:Label text="Infernal Depths" class="layer-name" />
                            <ui:VisualElement class="layer-deco-line layer-deco-line--right" />
                        </ui:VisualElement>
                        <ui:VisualElement class="slot-row">
                            <ui:VisualElement class="empty-slot">
                                <ui:Label text="+" class="empty-slot-icon" />
                            </ui:VisualElement>
                            <ui:VisualElement class="empty-slot">
                                <ui:Label text="+" class="empty-slot-icon" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="right-content" style="flex-grow: 1; flex-basis: 0; overflow: hidden; flex-direction: column; padding-top: 12px; padding-bottom: 12px; padding-left: 36px; padding-right: 24px;">
            <ui:Label name="roster-placeholder" text="Select an adventurer" class="text-body" style="-unity-text-align: middle-center; flex-grow: 1; font-size: 32px; display: none;" />
            <ui:VisualElement name="detail-container" style="display: flex; flex-direction: column; flex-grow: 1;">
                <ui:VisualElement style="position: relative; height: 250px; flex-shrink: 0; margin-bottom: 2px;">
                    <ui:VisualElement class="detail-class-badge">
                        <ui:VisualElement class="detail-class-circle">
                            <ui:VisualElement class="detail-class-icon" style="width: 80px; height: 80px;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-class-banner">
                            <ui:Label name="detail-class" text="Novice" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:VisualElement style="width: 210px; height: 210px; position: relative;">
                            <ui:VisualElement class="detail-diamond" />
                            <ui:VisualElement name="detail-sprite-frame" class="detail-sprite-frame" style="position: absolute; top: 14px; left: 30px;">
                                <ui:VisualElement name="detail-sprite" class="detail-sprite" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="position: absolute; left: 0; right: 0; bottom: 0; align-items: center;">
                        <ui:VisualElement class="detail-name-banner">
                            <ui:Label name="detail-name" text="Astrid" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-epithet-banner">
                            <ui:Label name="detail-epithet" text="the Long Example" />
                        </ui:VisualElement>
                        <ui:Label name="detail-layer" text="Abandoned Mines" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="detail-exp-row">
                    <ui:VisualElement class="detail-rank-shield">
                        <ui:Label name="detail-rank-number" text="I" />
                    </ui:VisualElement>
                    <ui:VisualElement class="detail-exp-col">
                        <ui:VisualElement class="detail-exp-head">
                            <ui:Label text="EXP" class="detail-exp-label" />
                            <ui:Label name="detail-rank-name" text="Wood" />
                            <ui:Label name="xp-label-value" text="99 / 100" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-bar-bg">
                            <ui:VisualElement name="detail-xp-fill" class="detail-xp-fill" style="width: 68%;" />
                        </ui:VisualElement>
                        <ui:Button name="detail-promote-btn" text="Promote" class="btn-success btn-sm" style="display: none; margin-top: 8px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="detail-section">
                    <ui:VisualElement class="detail-section-head">
                        <ui:VisualElement class="detail-section-deco" />
                        <ui:Label text="Stats" class="detail-section-title" />
                        <ui:VisualElement class="detail-section-deco detail-section-deco--right" />
                    </ui:VisualElement>
                    <ui:VisualElement class="detail-badge-row">
                        <ui:VisualElement class="detail-badge">
                            <ui:Label text="DPS" class="detail-badge-label" />
                            <ui:Label name="stat-dps" text="3" class="detail-badge-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-badge">
                            <ui:Label text="SPD" class="detail-badge-label" />
                            <ui:Label name="stat-spd" text="3" class="detail-badge-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-badge">
                            <ui:Label text="HP" class="detail-badge-label" />
                            <ui:Label name="hp-label-value" text="100/100" class="detail-badge-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="detail-section">
                    <ui:VisualElement class="detail-section-head">
                        <ui:VisualElement class="detail-section-deco" />
                        <ui:Label text="Traits &amp; Skills" class="detail-section-title" />
                        <ui:VisualElement class="detail-section-deco detail-section-deco--right" />
                    </ui:VisualElement>
                    <ui:VisualElement name="detail-traits" class="detail-badge-row" />
                </ui:VisualElement>
                <ui:VisualElement class="detail-desc-box">
                    <ui:Label name="detail-description" text="A fearless fighter who charges headlong into danger." class="detail-description" style="white-space: normal;" />
                </ui:VisualElement>
                <ui:VisualElement class="detail-dismiss-row">
                    <ui:Button name="detail-dismiss-btn" text="Dismiss" class="btn-danger btn-sm" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
