<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="page-root" style="flex-direction: row; flex-grow: 1;">
        <ui:VisualElement name="left-content" style="flex-grow: 1; flex-basis: 0; overflow: hidden; padding: 16px; margin-right: 4px;">
            <ui:Label text="Adventurers" class="page-header text-h2" style="margin-bottom: 8px;" />
            <ui:ScrollView name="roster-list" style="flex-grow: 1;" />
        </ui:VisualElement>
        <ui:VisualElement name="right-content" style="flex-grow: 1; flex-basis: 0; overflow: hidden; padding: 16px; margin-left: 4px;">
            <ui:Label name="roster-right-placeholder" text="Select an adventurer" class="text-body" style="color: rgb(170, 160, 140); -unity-text-align: middle-center; flex-grow: 1;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
