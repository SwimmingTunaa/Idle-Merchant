<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/GlobalVariables.uss?fileID=7433441132597879392&amp;guid=a78c87095b9cb4d12a022ef277e19da6&amp;type=3#GlobalVariables" />
    <Style src="project://database/Assets/Scripts/UI/Panels/Roster/RosterPanel.uss?fileID=7433441132597879392&amp;guid=fcda90a85139941bea862f290df11926&amp;type=3#RosterPanel" />
    <ui:VisualElement name="slot-wrapper" style="position: relative; margin: 6px; cursor: pointer;">
        <ui:VisualElement name="slot-frame" class="slot-frame" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
            <ui:VisualElement name="unit-icon" style="position: absolute; top: 1px; left: 1px; right: -1px; bottom: -1px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Light/1.png?fileID=2800000&amp;guid=fb08b7086b61243559614acce662b44e&amp;type=3#1&quot;);" />
            <ui:VisualElement name="slot-overlay" style="position: absolute; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.55); padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;">
                <ui:VisualElement class="slot-bar-bg">
                    <ui:VisualElement name="slot-xp-fill" class="slot-xp-fill" style="width: 60%;" />
                </ui:VisualElement>
                <ui:VisualElement class="slot-bar-bg" style="margin-top: 2px;">
                    <ui:VisualElement name="slot-hp-fill" class="slot-hp-fill" style="width: 75%;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="rank-container" style="position: absolute; top: -10px; left: -8px; width: 40px; height: 40px; background-image: url(&quot;project://database/Assets/Sprites/UI/Hire%20Menu/adventurer%20badge%20Background.png?fileID=2800000&amp;guid=2e3cf9576aa94484baa390a68e8a8034&amp;type=3#adventurer badge Background&quot;); -unity-background-image-tint-color: rgb(130, 130, 130); align-items: center; justify-content: center;">
            <ui:VisualElement name="rank-border" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-image: url(&quot;project://database/Assets/Sprites/UI/Hire%20Menu/adventurer%20badge%20Border.png?fileID=2800000&amp;guid=b8ba2a3fed1324a4db468921b4ae72b5&amp;type=3#adventurer badge Border&quot;); justify-content: center; align-items: center;">
                <ui:Label name="rank-level" text="4" style="color: rgb(248, 248, 248); font-size: 14px; -unity-font-style: bold; padding-top: 8px; padding-left: 1px; margin: 0; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&amp;guid=bf0206d6060cb4ed89e74ae40ea01e22&amp;type=3#NotJamBlkltr13&quot;);" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
