.mt-root {
    position: relative;
    top: 0;
    right: 0;
    width: 320px;
    background-color: rgba(255, 255, 255, 0);
}

/* Wood-framed plank. rotate = attention wiggle driven by UIManager.SetBoardBadge. */
.mt-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-xs) var(--space-md);
    background-image: url("project://database/Assets/Sprites/UI/Main%20UI/Box.png?fileID=2800000&guid=b1a09ce780a154f14af9ecb3b7d86965&type=3#Box");
    -unity-slice-left: 5;
    -unity-slice-right: 5;
    -unity-slice-top: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 5px;
    cursor: link;
    transition-property: rotate;
    transition-duration: 0.08s;
    transition-timing-function: ease-in-out;
}

.mt-header:hover {
    -unity-background-image-tint-color: rgb(226, 196, 164);
}

.mt-header-left {
    flex-direction: row;
    align-items: center;
}

.mt-star-label {
    color: var(--color-text-strong);
    margin-right: var(--space-sm);
}

.mt-count-label {
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

.mt-chevron {
    color: var(--color-text-strong);
    font-size: 12px;
    transition-property: rotate;
    transition-duration: var(--transition-normal);
}

.mt-chevron--collapsed {
    rotate: 180deg;
}

/* Claimable count: gold slip on the plank's top-left (tracker hugs the right screen edge).
   Base position/visibility from .hiring-badge (MainUI.uss). */
.mt-claim-badge {
    top: -12px;
    left: -12px;
    right: auto;
    width: 30px;
    height: 30px;
    border-width: 3px;
    border-color: rgb(20, 14, 10);
    background-color: var(--color-warning);
    color: var(--color-text-strong);
    font-size: 26px;
    padding: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--font-body);
}

.mt-body {
    overflow: hidden;
}

.mt-list {
    flex-direction: column;
    padding-top: var(--space-sm);
}

/* ── Torn-paper milestone card (card-torn.png 9-slice is inline in MilestoneCard.uxml) ── */

.mt-card {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: var(--space-sm);
    padding: 14px;
}

.mt-card--claimable {
    -unity-background-image-tint-color: rgb(255, 222, 140);
}

.mt-card--claimed {
    opacity: 0.62;
}

.mt-card-row {
    flex-direction: row;
    align-items: flex-start;
}

.mt-card-icon-frame {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    margin-right: 12px;
    padding: 4px;
    background-color: var(--color-box-bg);
    border-width: 3px;
    border-color: var(--color-border-dark);
    border-radius: var(--radius-sm);
}

.mt-card-icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.mt-card-info {
    flex-grow: 1;
    flex-shrink: 1;
}

.mt-card-name {
    font-size: 24px;
    white-space: normal;
    color: var(--color-text-strong);
    -unity-font-definition: var(--font-body);
}

.mt-card-desc {
    font-size: 16px;
    white-space: normal;
    color: var(--color-text-primary);
    -unity-font-definition: var(--font-body);
}

.mt-card-bar.progress-track {
    margin-top: 6px;
    height: 20px;
    background-color: var(--primary-200);
    border-width: 2px;
    border-color: var(--color-box-border);
    border-radius: 3px;
}

.mt-card .progress-fill {
    border-radius: 0;
}

.mt-card .progress-label {
    color: var(--color-text-strong);
    -unity-font-definition: var(--font-body);
}

.mt-card--claimed .progress-fill {
    background-color: var(--color-text-muted);
}

.mt-card-reward {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.mt-card-reward-coin {
    width: 18px;
    height: 18px;
    margin-left: 0;
    margin-right: 6px;
}

.mt-card-reward-label {
    font-size: 16px;
    color: var(--color-text-primary);
    -unity-font-definition: var(--font-body);
}

.mt-card--claimable .mt-card-reward {
    display: none;
}

/* Gold claim button (Button.uss .btn-gold) — only while claimable */
.mt-card-claim {
    display: none;
    width: 100%;
    height: 48px;
    margin: 10px 0 0 0;
    padding: 3px 10px 9px 10px;
    font-size: 28px;
    flex-shrink: 0;
}

.mt-card--claimable .mt-card-claim {
    display: flex;
}

.mt-card-claim-coin {
    margin-left: 8px;
    margin-right: 4px;
}

.mt-card-stamp {
    display: none;
    position: absolute;
    top: 8px;
    right: 10px;
    padding: 0 6px;
    rotate: -7deg;
    font-size: 20px;
    color: var(--color-success-active);
    border-width: 2px;
    border-color: var(--color-success-active);
    background-color: rgba(250, 240, 220, 0.75);
    -unity-font-definition: var(--font-body);
}

.mt-card--claimed .mt-card-stamp {
    display: flex;
}
