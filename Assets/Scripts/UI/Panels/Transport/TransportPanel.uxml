<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/GlobalVariables.uss?fileID=7433441132597879392&amp;guid=a78c87095b9cb4d12a022ef277e19da6&amp;type=3#GlobalVariables" />
    <Style src="project://database/Assets/Scripts/UI/Components/Button.uss?fileID=7433441132597879392&amp;guid=ca85a2c69b8914d29a2cd1cd9d9d5556&amp;type=3#Button" />
    <Style src="project://database/Assets/Scripts/UI/Panels/Workshop/WorkshopPanel.uss" />
    <Style src="project://database/Assets/Scripts/UI/Panels/Decorate/DecoratePanel.uss" />
    <Style src="project://database/Assets/Scripts/UI/Panels/Transport/TransportPanel.uss" />
    <!-- Transport modal: filled + shown by TransportPanelController (click a dungeon ladder). Decorate's look; the host is the backdrop. -->
    <ui:VisualElement name="transport-panel" class="dp-host">
        <ui:VisualElement name="tp-card" class="wp-card dp-card">
            <ui:VisualElement picking-mode="Ignore" class="wp-beam" />
            <ui:VisualElement class="dp-body">
                <ui:VisualElement class="wp-head">
                    <ui:Label name="tp-title" text="Depth 1 ladder" class="wp-title" />
                    <ui:Button name="tp-close" class="wp-close">
                        <ui:Label text="X" picking-mode="Ignore" class="wp-close__x" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:Label name="tp-sub" text="Porters climb this ladder at walking pace." class="tp-sub" />
                <ui:VisualElement name="tp-rows" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
