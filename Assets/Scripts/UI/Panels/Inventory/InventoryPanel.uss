.inventory-ledger {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Salmon%20Typewriter%209%20Regular.ttf?fileID=12800000&guid=2c162277ddf0d4f9fa96298d0a4c7a84&type=3#Salmon Typewriter 9 Regular");
}

.category-tab {
    width: 115px;
    height: 100px;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/BackbookPagesAndBookMarks/BookMarks/1.png?fileID=2800000&guid=ab0e9b587c94e4b36bbaf12e9275ef4f&type=3#1");
    background-size: 100% 100%;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    margin: 0;
    -unity-slice-scale: 5;
    margin-right: 8px;
}

.category-tab:hover {
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/BackbookPagesAndBookMarks/BookMarks/2.png?fileID=2800000&guid=8a35e9ec1fcd04d758023e03c276d6f1&type=3#2");
}

.category-tab-selected {
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/BackbookPagesAndBookMarks/BookMarks/3.png?fileID=2800000&guid=9794cf6e36b7b4bd5aca8f44a05aa324&type=3#3");
}

.filter-icon {
    position: absolute;
    width: 60px;
    height: 60px;
    left: 50%;
    top: 50%;
    translate: -30px -30px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}


.item-slot {
    cursor: link;
    transition-duration: 0.15s;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/inventory%20slot.png?fileID=21300000&guid=850d10acc4e4542a69dda03262628525&type=3#inventory slot");
    -unity-background-image-tint-color: rgb(245, 203, 182);
}

.item-slot:hover {
    border-color: rgb(200, 150, 0);
    border-width: 3px;
    scale: 1.05;
}


.item-slot-selector {
    position: absolute;
    width: 88px;
    height: 88px;
    left: 50%;
    top: 50%;
    translate: -44px -44px;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Inscriptions/Dark/Selector-icons.png?fileID=1731615565123986282&guid=8e6332101472e45c58825f1b34a754da&type=3#selector-red");
    background-size: 88px 88px;
    display: none;
}

.item-slot-selected .item-slot-selector {
    display: flex;
}

.item-slot-empty {
    cursor: default;
    opacity: 0.3;
    background-color: rgba(139, 90, 60, 0.15);
    border-style: dashed;
}

.item-slot-empty:hover {
    border-color: rgb(139, 90, 60);
    border-width: 2px;
    scale: 1;
}


.detail-name {
    -unity-font-style: bold;
}

.detail-description {
    white-space: normal;
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.action-button {
    cursor: link;
    transition-duration: 0.2s;
    -unity-font-style: bold;
}

.action-button:hover {
    scale: 1.05;
    border-width: 3px;
    border-color: rgb(250, 240, 220);
}

.action-button:active {
    scale: 0.95;
}

.quantity-badge {
    -unity-font-style: bold;
}


.item-slot:hover .quantity-badge {
    background-color: rgba(0, 0, 0, 0.9);
    scale: 1.1;
}

.stat-container {
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Light/12_2.png?fileID=-7954138311804534128&guid=847c65b70758a4b6f849ec8a43ec2e9b&type=3#12_2_0");
    background-size: 100% 100%;
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 3;
    -unity-slice-scale: 5;
}
