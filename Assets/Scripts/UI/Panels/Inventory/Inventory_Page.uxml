            <ui:VisualElement name="description-container" style="flex-grow: 1; align-self: stretch; -unity-background-scale-mode: stretch-to-fill; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/text-box-slice.png?fileID=3997786295894542459&amp;guid=4c3028ba947224aa4a305c692c8087ed&amp;type=3#text-box-slice_0&quot;); -unity-slice-left: 2; -unity-slice-top: 2; -unity-slice-right: 2; -unity-slice-bottom: 2; -unity-slice-scale: 5px; padding: 16px;">
                <ui:Label name="detail-description" text="A worn but sturdy iron cog salvaged from the mines. Miners use these to repair equipment — or trade them for a tidy sum at the right market stall." style="font-size: 24px; color: rgb(70, 45, 20); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;); white-space: normal; flex-grow: 1;" />
