        <ui:VisualElement name="right-content" style="flex-grow: 1; flex-basis: 0; flex-direction: column; overflow: hidden; padding-left: 55px; align-items: center;">
            <ui:VisualElement name="sprite-container" style="flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0;">
                <ui:VisualElement name="deco-diamond-line 4" style="width: 130px; height: 60px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-diamond-line.png?fileID=2800000&amp;guid=2113edcd15d6a4096a25fbbc91c2bad5&amp;type=3#deco-diamond-line&quot;); scale: -1 1; margin-right: 16px;" />
                <ui:VisualElement name="slot" style="width: 210px; height: 210px; align-items: center; justify-content: center; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-diamond-big.png?fileID=2800000&amp;guid=dc67f5857d1cc48f49c6bf8c91eedf54&amp;type=3#deco-diamond-big&quot;); background-size: 103% 100%; -unity-background-scale-mode: scale-to-fit;">
                    <ui:VisualElement name="detail-icon" style="width: 176px; height: 176px; -unity-background-scale-mode: scale-to-fit;" />
                </ui:VisualElement>
                <ui:VisualElement name="deco-diamond-line 3" style="width: 130px; height: 60px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-diamond-line.png?fileID=2800000&amp;guid=2113edcd15d6a4096a25fbbc91c2bad5&amp;type=3#deco-diamond-line&quot;); margin-left: 16px;" />
            </ui:VisualElement>
            <ui:VisualElement name="item-name-container" style="width: 400px; height: 80px; flex-direction: column; align-items: center; justify-content: center; padding-bottom: 16px; flex-shrink: 0; margin-top: 16px; -unity-background-scale-mode: stretch-to-fill; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-title-banner.png?fileID=2800000&amp;guid=992d1ea8d5ec74d89b5301bb26534a78&amp;type=3#deco-title-banner&quot;);">
                <ui:Label name="detail-name" text="Select an item" style="font-size: 32px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;); -unity-text-align: middle-center; height: 30px;" />
            </ui:VisualElement>
            <ui:VisualElement name="Metrics" style="flex-direction: row; align-items: flex-start; flex-shrink: 0; align-self: stretch; margin-top: 16px;">
