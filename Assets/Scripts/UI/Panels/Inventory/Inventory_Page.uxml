        <!-- ══════════════ RIGHT PAGE ══════════════ -->
        <ui:VisualElement name="right-content" style="flex-grow: 1; flex-basis: 0; overflow: hidden; padding: 20px 20px 16px 12px; align-items: center; flex-direction: column;">

            <!-- Large item display: deco-line + diamond slot + deco-line -->
