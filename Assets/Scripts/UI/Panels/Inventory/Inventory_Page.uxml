                        <ui:Label text="x12" style="position: absolute; bottom: -1px; right: -3px; background-color: rgba(0, 0, 0, 0.7); color: white; padding: 2px 6px; border-radius: 3px; font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;);" />
                        <ui:VisualElement style="position: absolute; top: -6px; right: -8px; width: 26px; height: 27px; background-color: rgb(200, 150, 0); border-radius: 20px; border-width: 2px; border-color: rgb(250, 240, 220); align-items: center; justify-content: center; display: flex;">
                            <ui:Label text="$" style="font-size: 16px; color: white; -unity-font-style: bold; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;);" />
