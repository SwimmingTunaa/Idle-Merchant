                    <ui:Label name="capacity-label" text="Capacity: 18 / 50" class="text-small" style="color: rgb(70, 45, 20); margin-right: 8px;" />
                    <ui:Label name="gold-label" text="1,240g" class="text-small" style="color: rgb(200, 150, 0);" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="item-grid-scroll" style="flex-grow: 1;">
                <ui:VisualElement name="item-grid" class="item-grid" style="flex-wrap: wrap; flex-direction: row;">
                    <!-- Iron Gear x12, for sale — SELECTED -->
