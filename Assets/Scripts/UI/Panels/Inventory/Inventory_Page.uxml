                        <ui:Label text="x2" style="position: absolute; bottom: -1px; right: -3px; background-color: rgba(0, 0, 0, 0.7); color: white; padding: 2px 6px; border-radius: 3px; font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;);" />
                    </ui:VisualElement>
                    <!-- Chest x1, reserved 1 -->
                    <ui:VisualElement class="item-slot" style="width: 85px; height: 85px; margin: 4px; position: relative; justify-content: center; align-items: center;">
