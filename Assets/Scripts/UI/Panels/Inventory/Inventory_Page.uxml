<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="ItemSlot" src="project://database/Assets/Scripts/UI/Panels/Inventory/ItemSlot.uxml?fileID=9197481963319205126&amp;guid=561d352404136405e83576f96fac8bb1&amp;type=3#ItemSlot" />
    <Style src="project://database/Assets/Scripts/UI/GlobalVariables.uss?fileID=7433441132597879392&amp;guid=a78c87095b9cb4d12a022ef277e19da6&amp;type=3#GlobalVariables" />
    <Style src="project://database/Assets/Scripts/UI/Panels/Inventory/InventoryPanel.uss?fileID=7433441132597879392&amp;guid=74ac0a55dbd8b4dbc9772a233525715e&amp;type=3#InventoryPanel" />
    <ui:VisualElement name="page-root" style="flex-direction: row; flex-grow: 1; overflow: hidden;">
        <ui:VisualElement name="left-content" style="flex-grow: 1; flex-basis: 0; flex-direction: column; overflow: hidden; padding-right: 55px; align-items: center;">
            <ui:VisualElement name="book-header" style="flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0;">
                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center;">
                    <ui:VisualElement name="deco-swirl 1" style="width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-swirl.PNG?fileID=2800000&amp;guid=7f697000926e54b27b639ae0ee9a7656&amp;type=3#deco-swirl&quot;);" />
                    <ui:Label name="page-title" text="Inventory" style="font-size: 52px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&amp;guid=bf0206d6060cb4ed89e74ae40ea01e22&amp;type=3#NotJamBlkltr13&quot;); -unity-text-align: middle-center; margin-left: 16px; margin-right: 16px;" />
                    <ui:VisualElement name="deco-swirl 2" style="width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-swirl.PNG?fileID=2800000&amp;guid=7f697000926e54b27b639ae0ee9a7656&amp;type=3#deco-swirl&quot;);" />
                </ui:VisualElement>
                <ui:VisualElement name="deco-underline 1" style="width: 415px; height: 40px; -unity-background-scale-mode: stretch-to-fill; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-underline.png?fileID=2800000&amp;guid=0ae5cfc3aea744660aaf241e3f2c6ea9&amp;type=3#deco-underline&quot;); margin-top: 10px;" />
            </ui:VisualElement>
            <ui:ScrollView name="item-grid-scroll" style="flex-grow: 1; width: 100%; margin-top: 32px;">
                <ui:VisualElement name="item-grid" style="flex-wrap: wrap; flex-direction: row; justify-content: center; align-items: flex-start; padding: 4px;">
                    <ui:Instance template="ItemSlot" />
                    <ui:Instance template="ItemSlot" />
                    <ui:Instance template="ItemSlot" />
                    <ui:Instance template="ItemSlot" />
                    <ui:Instance template="ItemSlot" />
                    <ui:Instance template="ItemSlot" />
                    <ui:Instance template="ItemSlot" />
                    <ui:Instance template="ItemSlot" class="item-slot-empty" />
                    <ui:Instance template="ItemSlot" class="item-slot-empty" />
                    <ui:Instance template="ItemSlot" class="item-slot-empty" />
                    <ui:Instance template="ItemSlot" class="item-slot-empty" />
                    <ui:Instance template="ItemSlot" class="item-slot-empty" />
                    <ui:Instance template="ItemSlot" class="item-slot-empty" />
                    <ui:Instance template="ItemSlot" class="item-slot-empty" />
                    <ui:Instance template="ItemSlot" class="item-slot-empty" />
                </ui:VisualElement>
            </ui:ScrollView>
