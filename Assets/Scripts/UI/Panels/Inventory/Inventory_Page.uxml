                    <ui:Label name="forsale-label" text="Not For Sale" style="font-size: 16px; color: rgb(70, 45, 20); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;); -unity-text-align: middle-center;" />
                </ui:VisualElement>

                <!-- Value badge: number + coin icon -->
                <ui:VisualElement name="value-badge" style="height: 48px; flex-direction: row; align-items: center; justify-content: center; padding: 0 12px; gap: 4px; -unity-background-scale-mode: stretch-to-fill; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/box-splice.png?fileID=1142012838051687708&amp;guid=7431fc87a504d4dc29fd217299608c7f&amp;type=3#box-splice_0&quot;); -unity-slice-left: 2; -unity-slice-top: 2; -unity-slice-right: 2; -unity-slice-bottom: 2; -unity-slice-scale: 5px;">
                    <ui:Label name="item-value" text="45" style="font-size: 16px; color: rgb(70, 45, 20); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;);" />
                    <ui:VisualElement style="width: 24px; height: 24px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/Icons/spinning%20coin.png?fileID=3719480491199129836&amp;guid=64d83157b3e0543fe912b4fad69aa702&amp;type=3#spinning coin_0&quot;);" />
                </ui:VisualElement>

                <!-- Reserved count badge -->
                <ui:VisualElement name="reserved-badge" style="height: 48px; flex-direction: row; align-items: center; justify-content: center; padding: 0 12px; gap: 6px; -unity-background-scale-mode: stretch-to-fill; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/box-splice.png?fileID=1142012838051687708&amp;guid=7431fc87a504d4dc29fd217299608c7f&amp;type=3#box-splice_0&quot;); -unity-slice-left: 2; -unity-slice-top: 2; -unity-slice-right: 2; -unity-slice-bottom: 2; -unity-slice-scale: 5px;">
                    <ui:Label text="Reserved" style="font-size: 16px; color: rgb(70, 45, 20); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;);" />
                    <ui:IntegerField name="reserve-count" value="2" style="width: 40px; font-size: 16px; color: rgb(70, 45, 20); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;);" />
                </ui:VisualElement>

