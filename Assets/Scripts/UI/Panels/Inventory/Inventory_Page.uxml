                    <ui:Label name="forsale-label" text="Not For Sale" style="font-size: 24px; color: rgb(170, 160, 140); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;); -unity-text-align: middle-center;" />
                </ui:VisualElement>
                <ui:VisualElement name="value-badge" style="flex-grow: 1; flex-basis: 0; height: 52px; flex-direction: row; align-items: center; justify-content: center; margin-left: 8px; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/box-splice.png?fileID=1142012838051687708&amp;guid=7431fc87a504d4dc29fd217299608c7f&amp;type=3#box-splice_0&quot;); -unity-slice-left: 8; -unity-slice-top: 3; -unity-slice-right: 8; -unity-slice-bottom: 3; -unity-slice-scale: 3px;">
                    <ui:Label name="item-value" text="—" style="font-size: 40px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;);" />
                    <ui:VisualElement name="spinning coin 1" style="width: 30px; height: 27px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/Icons/spinning%20coin.png?fileID=3719480491199129836&amp;guid=64d83157b3e0543fe912b4fad69aa702&amp;type=3#spinning coin_0&quot;); margin-left: 4px;" />
                </ui:VisualElement>
                <ui:VisualElement name="reserved-input" style="flex-grow: 1; flex-basis: 0; height: 52px; flex-direction: row; align-items: center; justify-content: center; margin-left: 8px; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/box-splice.png?fileID=1142012838051687708&amp;guid=7431fc87a504d4dc29fd217299608c7f&amp;type=3#box-splice_0&quot;); -unity-slice-left: 8; -unity-slice-top: 3; -unity-slice-right: 8; -unity-slice-bottom: 3; -unity-slice-scale: 3px; padding-left: 16px; padding-right: 8px; padding-top: 5px; padding-bottom: 5px;">
                    <ui:VisualElement name="icon &amp; text" style="flex-grow: 1; flex-basis: 0; flex-direction: row; align-items: center;">
                        <ui:VisualElement name="Lock" style="width: 20px; height: 24px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Icons/lock.svg?fileID=7388822144124034973&amp;guid=b85ff3f7aa304a0d8c6996191dbc0ddb&amp;type=3#lock&quot;);" />
                        <ui:Label name="reserve-count" text="0" style="font-size: 40px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;); margin-left: 8px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="reserve-stepper" style="flex-direction: column; align-items: stretch; justify-content: center; flex-shrink: 1; align-self: stretch; margin-bottom: 8px; margin-top: 8px;">
                        <ui:VisualElement name="reserve-up" class="reserve-step-btn" style="flex-grow: 1; flex-basis: 0; align-items: center; justify-content: center; padding: 4px; border-bottom-width: 1px;">
                            <ui:VisualElement name="arrow" picking-mode="Ignore" style="width: 12.5px; height: 5px; -unity-background-scale-mode: stretch-to-fill; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Icons/arrow-up.svg?fileID=7388822144124034973&amp;guid=d74b06c23651248108bf294c044d919a&amp;type=3#arrow-up&quot;);" />
                        </ui:VisualElement>
                        <ui:VisualElement name="reserve-down" class="reserve-step-btn" style="flex-grow: 1; flex-basis: 0; align-items: center; justify-content: center; padding: 4px;">
                            <ui:VisualElement name="arrow" picking-mode="Ignore" style="width: 12.5px; height: 5px; scale: 1 -1; -unity-background-scale-mode: stretch-to-fill; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Icons/arrow-up.svg?fileID=7388822144124034973&amp;guid=d74b06c23651248108bf294c044d919a&amp;type=3#arrow-up&quot;);" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="description-container" style="flex-shrink: 0; align-self: stretch; height: 150px; padding: 16px; margin-top: 16px; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/text-box-slice.png?fileID=3997786295894542459&amp;guid=4c3028ba947224aa4a305c692c8087ed&amp;type=3#text-box-slice_0&quot;); -unity-slice-left: 1; -unity-slice-top: 1; -unity-slice-right: 1; -unity-slice-bottom: 1; -unity-slice-scale: 5;">
                <ui:Label name="detail-description" text="Select an item to view details." style="flex-grow: 1; font-size: 24px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;); white-space: normal;" />
            </ui:VisualElement>
            <ui:VisualElement name="forsale-stamp" style="position: absolute; left: 52px; right: 370px; top: 330px; bottom: 308px; cursor: link; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Custom/for-sale-stamp-sheet.png?fileID=1729883773912937322&amp;guid=019c67496337345b5b1654dbcc071b00&amp;type=3#for-sale-stamp-sheet_0&quot;); display: flex; align-items: center; justify-content: center; rotate: -17deg; width: 175px; height: 52px;">
                <ui:Label name="forsale-stamp-text" text="FOR SALE" style="font-size: 24px; color: rgb(215, 181, 148); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;); -unity-text-align: middle-center; -unity-text-outline-width: 0; -unity-text-outline-color: rgb(80, 20, 20);" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Stampanim" picking-mode="Ignore" style="flex-grow: 0; position: absolute; width: 593px; height: 594px; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Custom/Stamp.png?fileID=5564853175316236378&amp;guid=6fdb63f54eb1349438d92a27ec084b83&amp;type=3#Stamp_5&quot;); top: 1px; left: 388px; display: flex;" />
