                <ui:Label name="page-title" text="Inventory" style="font-size: 52px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&amp;guid=bf0206d6060cb4ed89e74ae40ea01e22&amp;type=3#NotJamBlkltr13&quot;); color: rgb(70, 45, 20); -unity-text-align: middle-center;" />
                <ui:VisualElement name="deco-swirl-right" style="width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/deco-swirl-right.PNG?fileID=140487574076577522&amp;guid=ee8e6e92ee45b4ebeaa0699d75dc2999&amp;type=3#deco-swirl-right_0&quot;); margin-left: 8px;" />
            </ui:VisualElement>

            <!-- Underline deco -->
