<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/Panels/Inventory/InventoryPanel.uss?fileID=7433441132597879392&amp;guid=74ac0a55dbd8b4dbc9772a233525715e&amp;type=3#InventoryPanel" />
    <ui:VisualElement name="page-root" style="flex-direction: row; flex-grow: 1; width: auto;">
        <ui:VisualElement name="left-content" style="flex-grow: 1; flex-basis: 0; overflow: hidden; padding: 16px; margin-right: 4px; padding-right: 48px; padding-left: 32px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <ui:Label name="category-title" text="All Items" class="header-title" style="font-size: 20px; color: rgb(50, 30, 10);" />
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Label name="capacity-label" text="Capacity: 0" style="font-size: 14px; color: rgb(70, 45, 20); margin-right: 8px;" />
                    <ui:Label name="gold-label" text="0g" style="font-size: 16px; color: rgb(200, 150, 0);" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="item-grid-scroll" style="flex-grow: 1;">
                <ui:VisualElement name="item-grid" class="item-grid" style="flex-wrap: wrap; flex-direction: row;" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="right-content" style="flex-grow: 1; flex-basis: 0; overflow: hidden; padding: 16px; margin-left: 4px; padding-left: 48px; padding-right: 32px;">
            <ui:VisualElement name="detail-panel" class="detail-panel" style="flex-grow: 1; display: flex;">
                <ui:VisualElement name="detail-icon-container" style="align-items: center; margin-bottom: 12px; height: 150px; justify-content: center; flex-direction: row;">
                    <ui:VisualElement name="detail-icon-bg" style="width: 150px; height: 150px; background-color: rgba(231, 197, 134, 0); border-radius: 8px; border-width: 2px; border-color: rgb(139, 90, 60); position: absolute; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/4.png?fileID=2800000&amp;guid=bfa284f44fd3a409a9bf265f305ea360&amp;type=3#4&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; align-self: center;" />
                    <ui:VisualElement name="deco" style="width: 160px; height: 60px; background-color: rgba(231, 197, 134, 0); border-radius: 8px; border-width: 2px; border-color: rgb(139, 90, 60); position: relative; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/3_Right_16x16.png?fileID=4217371202849751748&amp;guid=f6ce0fa1c6896481b972c924e2abb5da&amp;type=3#single&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; rotate: 180deg; margin-right: 48px;" />
                    <ui:VisualElement name="detail-icon" style="width: 80px; height: 80px; border-radius: 8px; border-width: 2px; border-color: rgb(139, 90, 60); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; align-self: center; align-items: center;" />
                    <ui:VisualElement name="deco" style="width: 160px; height: 60px; background-color: rgba(231, 197, 134, 0); border-radius: 8px; border-width: 2px; border-color: rgb(139, 90, 60); position: relative; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/3_Right_16x16.png?fileID=4217371202849751748&amp;guid=f6ce0fa1c6896481b972c924e2abb5da&amp;type=3#single&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; margin-left: 48px;" />
                </ui:VisualElement>
                <ui:Label name="detail-name" class="detail-name" style="font-size: 20px; color: rgb(50, 30, 10); -unity-text-align: upper-center; margin-bottom: 6px; -unity-font-style: bold;" />
                <ui:VisualElement name="description-container" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Light/12_2.png?fileID=-7954138311804534128&amp;guid=847c65b70758a4b6f849ec8a43ec2e9b&amp;type=3#12_2_0&quot;); -unity-background-image-tint-color: rgb(255, 255, 255); -unity-slice-left: 1; -unity-slice-top: 1; -unity-slice-right: 1; -unity-slice-bottom: 1; -unity-slice-scale: 5px; padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px;">
                    <ui:VisualElement name="empty-detail-message" style="flex-grow: 1; align-items: center; justify-content: center; display: none;">
                        <ui:Label text="No items available&#10;&#10;Add items to your inventory&#10;to see details here" style="font-size: 32px; color: rgb(128, 75, 23); -unity-text-align: middle-center; white-space: normal; padding-top: 20px; padding-bottom: 20px; padding-left: 10px; padding-right: 10px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;); flex-grow: 1;" />
                    </ui:VisualElement>
                    <ui:Label name="detail-description" class="detail-description" style="font-size: 24px; color: rgb(70, 45, 20); white-space: normal; margin-bottom: 12px; flex-grow: 1; display: flex;" />
                </ui:VisualElement>
                <ui:VisualElement name="stats-section" class="stats-box" style="flex-direction: row; margin-bottom: 12px; align-items: stretch;">
                    <ui:VisualElement name="stat-total-container" class="stat-container" style="flex-grow: 1; align-items: center; justify-content: center; height: 45px; margin: 4px; padding: 5px 8px;">
                        <ui:Label name="stat-total" text="Total: 0" class="stat-label" style="font-size: 14px; color: rgb(50, 30, 10);" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stat-reserved-container" class="stat-container" style="flex-grow: 1; align-items: center; justify-content: center; height: 45px; margin: 4px; padding: 5px 8px;">
                        <ui:Label name="stat-reserved" text="Reserved: 0" class="stat-label" style="font-size: 14px; color: rgb(50, 90, 150);" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stat-forsale-container" class="stat-container" style="flex-grow: 1; align-items: center; justify-content: center; height: 45px; margin: 4px; padding: 5px 8px;">
                        <ui:Label name="stat-forsale" text="For Sale: 0" class="stat-label" style="font-size: 14px; color: rgb(0, 120, 60);" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stat-value-container" class="stat-container" style="flex-grow: 1; align-items: center; justify-content: center; height: 45px; margin: 4px; padding: 5px 8px;">
                        <ui:Label name="stat-value" text="Value: 0g" class="stat-label" style="font-size: 14px; color: rgb(200, 150, 0);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Reserve" style="font-size: 14px; color: rgb(50, 30, 10); margin-bottom: 4px;" />
                <ui:SliderInt name="reserve-slider" style="margin-bottom: 10px;" />
                <ui:Toggle name="forsale-toggle" text="Mark For Sale" style="font-size: 14px; color: rgb(50, 30, 10);" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
