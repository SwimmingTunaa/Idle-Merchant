        <ui:VisualElement name="right-content" style="flex-grow: 1; flex-basis: 0; overflow: hidden; padding: 16px; margin-left: 4px; padding-left: 48px; padding-right: 32px;">
            <ui:VisualElement name="detail-panel" class="detail-panel" style="flex-grow: 1; display: flex;">
                <ui:VisualElement name="detail-icon-container" style="align-items: center; margin-bottom: 12px; height: 150px; justify-content: center; flex-direction: row;">
                    <ui:VisualElement name="detail-icon-bg" style="width: 150px; height: 150px; position: absolute; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/4.png?fileID=2800000&amp;guid=bfa284f44fd3a409a9bf265f305ea360&amp;type=3#4&quot;); align-self: center;" />
                    <ui:VisualElement name="deco" style="width: 160px; height: 60px; position: relative; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/3_Right_16x16.png?fileID=4217371202849751748&amp;guid=f6ce0fa1c6896481b972c924e2abb5da&amp;type=3#single&quot;); rotate: 180deg; margin-right: 48px;" />
                    <ui:VisualElement name="detail-icon" style="width: 80px; height: 80px; align-self: center; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/Loot/Pixel%20Art%20Icon%20Pack%20-%20RPG/Texture/Misc/Gear.png?fileID=2800000&amp;guid=042fae2dd68bce044b8fbd1f26724a2d&amp;type=3#Gear&quot;);" />
                    <ui:VisualElement name="deco" style="width: 160px; height: 60px; position: relative; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Titles%20and%20Underlying/3_Right_16x16.png?fileID=4217371202849751748&amp;guid=f6ce0fa1c6896481b972c924e2abb5da&amp;type=3#single&quot;); margin-left: 48px;" />
                </ui:VisualElement>
                <ui:Label name="detail-name" text="Iron Gear" class="text-h2" style="-unity-text-align: upper-center; margin-bottom: 6px;" />
                <ui:VisualElement name="description-container" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Light/12_2.png?fileID=-7954138311804534128&amp;guid=847c65b70758a4b6f849ec8a43ec2e9b&amp;type=3#12_2_0&quot;); -unity-slice-left: 1; -unity-slice-top: 1; -unity-slice-right: 1; -unity-slice-bottom: 1; -unity-slice-scale: 5px; padding: 16px;">
                    <ui:VisualElement name="empty-detail-message" style="flex-grow: 1; align-items: center; justify-content: center; display: none;">
                        <ui:Label text="No items available&#10;&#10;Add items to your inventory&#10;to see details here" class="text-body" style="font-size: 32px; color: rgb(128, 75, 23); -unity-text-align: middle-center; white-space: normal; padding: 20px 10px; flex-grow: 1;" />
                    </ui:VisualElement>
                    <ui:Label name="detail-description" text="A worn but sturdy iron cog salvaged from the mines. Miners use these to repair equipment — or trade them for a tidy sum at the right market stall." class="text-body" style="color: rgb(70, 45, 20); white-space: normal; margin-bottom: 12px; flex-grow: 1; display: flex;" />
                </ui:VisualElement>
                <ui:VisualElement name="stats-section" class="stats-box" style="flex-direction: row; margin-bottom: 12px; align-items: stretch;">
                    <ui:VisualElement name="stat-total-container" class="stat-container" style="flex-grow: 1; align-items: center; justify-content: center; height: 45px; margin: 4px; padding: 5px 8px;">
                        <ui:Label name="stat-total" text="Total: 12" class="text-small" style="color: rgb(50, 30, 10);" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stat-reserved-container" class="stat-container" style="flex-grow: 1; align-items: center; justify-content: center; height: 45px; margin: 4px; padding: 5px 8px;">
                        <ui:Label name="stat-reserved" text="Reserved: 2" class="text-small" style="color: rgb(50, 90, 150);" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stat-forsale-container" class="stat-container" style="flex-grow: 1; align-items: center; justify-content: center; height: 45px; margin: 4px; padding: 5px 8px;">
                        <ui:Label name="stat-forsale" text="For Sale: 5" class="text-small" style="color: rgb(0, 120, 60);" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stat-value-container" class="stat-container" style="flex-grow: 1; align-items: center; justify-content: center; height: 45px; margin: 4px; padding: 5px 8px;">
                        <ui:Label name="stat-value" text="Value: 45g" class="text-small" style="color: rgb(200, 150, 0);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Reserve" class="text-small" style="color: rgb(50, 30, 10); margin-bottom: 4px;" />
                <ui:SliderInt name="reserve-slider" value="2" high-value="12" style="margin-bottom: 10px;" />
                <ui:Toggle name="forsale-toggle" text="Mark For Sale" value="true" class="text-small" style="color: rgb(50, 30, 10);" />
