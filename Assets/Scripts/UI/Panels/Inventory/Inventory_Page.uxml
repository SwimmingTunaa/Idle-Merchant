                        <ui:Label text="x12" style="position: absolute; bottom: 2px; right: 2px; background-color: rgba(0,0,0,0.7); color: white; padding: 1px 4px; font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&amp;guid=b42dfca3fffbe4c5e9a29a3cd1074f71&amp;type=3#BrightLinger&quot;);" />
