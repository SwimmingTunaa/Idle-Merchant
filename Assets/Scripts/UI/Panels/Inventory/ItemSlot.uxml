        <ui:VisualElement name="slot-selector" class="item-slot-selector" />
        <ui:Label name="slot-quantity" text="x87" class="quantity-badge" style="position: absolute; bottom: -1px; right: -3px; background-color: rgba(0, 0, 0, 0.7); color: white; padding: 2px 6px; border-radius: 3px; font-size: 14px;" />
        <ui:Label name="slot-reserved" text="📦 20" class="reserved-badge" style="position: absolute; top: -3px; left: -3px; background-color: rgba(50, 90, 150, 0.9); color: white; padding: 2px 6px; border-radius: 3px; font-size: 12px; display: flex;" />
        <ui:VisualElement name="forsale-sticker" style="position: absolute; top: -6px; right: -8px; width: 26px; height: 27px; background-color: rgb(200, 150, 0); border-radius: 20px; border-width: 2px; border-color: rgb(250, 240, 220); align-items: center; justify-content: center; display: flex;">
            <ui:Label text="$" style="font-size: 16px; color: white; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Salmon%20Typewriter%209%20Regular.ttf?fileID=12800000&amp;guid=2c162277ddf0d4f9fa96298d0a4c7a84&amp;type=3#Salmon Typewriter 9 Regular&quot;); width: 3px; align-self: center;" />
        </ui:VisualElement>
