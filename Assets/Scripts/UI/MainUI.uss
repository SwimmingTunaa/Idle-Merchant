.main-ui-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
}

.left-container {
    flex-direction: row;
    align-items: flex-start;
    flex-grow: 1;
    flex-basis: 0;
}

.bookmarks-container {
    flex-direction: row;
    align-items: flex-start;
    padding-left: var(--space-xl);
    padding-top: var(--space-sm);
}

/* Hidden while the Book UI is open — its own tabs take over. visibility (not
   display) keeps the layout so the hiring sign doesn't shift. Toggled by
   BookPanelController. */
.bookmarks-container--hidden {
    visibility: hidden;
}

.bookmarks-shelf {
    position: absolute;
    left: 0;
    top: -1px;
    width: 660px;
    height: 65px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/BookSprite_Animation/Page1_trimmed-menu.png?fileID=2800000&guid=897d89fa15ddd4878bbc83d29d1cc134&type=3#Page1_trimmed-menu");
}

.bookmark-button {
    width: 85px;
    height: 120px;
    margin-right: var(--space-md);
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    position: relative;
    overflow: visible;
    transition-property: translate, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.bookmark-button:hover {
    translate: 0 4px;
}

.bookmark-button:active {
    scale: 0.96;
}

.bookmark-banner {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 120px;
    height: 85px;
    translate: -50% -50%;
    rotate: 90deg;
    justify-content: center;
    align-items: center;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    padding-right: 32px;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/BookMarksColor/Bookmark%20plain.PNG?fileID=2800000&guid=14bf641a149294182a29e6b15ed5a461&type=3#Bookmark plain");
}

.bookmark-icon {
    width: 60px;
    height: 60px;
    rotate: -90deg;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.hiring-menu-container {
    width: 160px;
    flex-direction: column;
    align-items: flex-start;
    margin-left: var(--space-xl);
}

.pols {
    width: 100%;
    height: 24px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: var(--space-lg);
    padding-right: var(--space-lg);
    margin-bottom: -16px;
}

.pole {
    width: 20px;
    height: 40px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Custom/pole.png?fileID=7811621924538912814&guid=52d8f14987736491ba4c8a67e70b9733&type=3#pole_0");
    -unity-background-scale-mode: scale-to-fit;
}

.hiring-menu-button {
    width: 160px;
    height: 100px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Custom/wooden%20board.png?fileID=-7773343379347938585&guid=ffabd942f6347418b9a274ff2a8ac207&type=3#wooden board_0");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* Stepped drop: 1 art pixel (5px), no tween — stays on the pixel grid. */
.hiring-menu-button:hover {
    translate: 0 5px;
}

.hiring-menu-button:active {
    scale: 0.96;
}

/* While HirePanel is open: sign stays dropped + warm palette shift (instant,
   like a sprite palette swap). Toggled by HireController. */
.hiring-menu-button--open {
    translate: 0 5px;
    -unity-background-image-tint-color: rgb(255, 244, 214);
}

/* New-candidates badge: pixel square (3x3 art px fill + 1 art px outline),
   sits inside the button so it drops with the board. Swap for a sprite later. */
.hiring-badge {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 25px;
    height: 25px;
    border-width: 5px;
    border-color: rgb(90, 30, 25);
    background-color: rgb(180, 60, 50);
    display: none;
}

.hiring-badge--visible {
    display: flex;
}

.middle {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.guild-section {
    flex-direction: column;
    align-items: center;
}

.stars-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: var(--space-sm);
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Custom/box-outline.png?fileID=-4031949096709143763&guid=80cf7c2e4874449dc844f214777954a9&type=3#box-outline_0");
    -unity-slice-left: 5;
    -unity-slice-right: 5;
    -unity-slice-top: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 1px;
}

.star {
    width: 32px;
    height: 32px;
    margin-right: var(--space-sm);
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Custom/Star.png?fileID=5199979006384268662&guid=391cae39f2cc64ebca5e7d6893d13427&type=3#Star_disabled");
    -unity-background-scale-mode: scale-to-fit;
}

.star-filled {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Custom/Star.png?fileID=-930353575&guid=391cae39f2cc64ebca5e7d6893d13427&type=3#Star_active");
}

.star-empty {
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Custom/Star.png?fileID=5199979006384268662&guid=391cae39f2cc64ebca5e7d6893d13427&type=3#Star_disabled");
}

.guild-flag {
    width: 185px;
    height: 225px;
    padding-top: var(--space-xxl);
    padding-bottom: 0;
    padding-left: var(--space-lg);
    padding-right: var(--space-lg);
    justify-content: flex-start;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/Flag_banner.png?fileID=2800000&guid=cf623e95db98f4e29817d62d8ed382a5&type=3#Flag_banner");
    -unity-background-scale-mode: scale-to-fit;
}

.label-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    max-width: 200px;
}

.guild-name-label {
    font-size: var(--font-size-h2);
    color: var(--secondary-300);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
    -unity-text-align: middle-center;
    white-space: normal;
}

.milestone-progress-label {
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
}

.stats-section {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 1;
    flex-basis: 0;
    padding-top: var(--space-md);
    padding-left: var(--space-md);
    padding-right: var(--space-md);
}

.coin-plate {
    width: 300px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-left: var(--space-xl);
    padding-right: var(--space-xl);
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
    background-image: url("project://database/Assets/Sprites/UI/Main%20UI/Box.png?fileID=2800000&guid=b1a09ce780a154f14af9ecb3b7d86965&type=3#Box");
    -unity-slice-left: 5;
    -unity-slice-right: 5;
    -unity-slice-top: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 5px;
}

.coin {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.coin-label {
    font-size: var(--font-size-body-xl);
    color: var(--color-text-strong);
    -unity-text-align: middle-right;
}

.coin-icon {
    width: 32px;
    height: 32px;
    margin-left: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.pulse-target {
    transition-property: scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
    scale: 1 1;
}

.pulse-target.pulsing {
    scale: 1.3 1.3;
}

.utility-buttons {
    flex-direction: row;
    align-items: center;
}

.utility-button {
    width: 40px;
    height: 40px;
    margin-left: var(--space-xs);
    background-color: rgb(100, 70, 40);
    border-width: 2px;
    border-color: rgb(150, 110, 70);
    border-radius: var(--radius-md);
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
}

.income-rate-label {
    font-size: var(--font-size-body-sm);
    color: rgb(100, 220, 100);
}

.layer-status-label {
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
}

.game-view-area {
    flex-grow: 1;
    background-color: transparent;
}

.unity-text-element {
}

.unity-button {
}
