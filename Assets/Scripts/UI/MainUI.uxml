<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="BookPanel" src="project://database/Assets/Scripts/UI/Panels/Book/BookPanel.uxml?fileID=9197481963319205126&amp;guid=c8a56a18023e84d3f9f6a7058be5abba&amp;type=3#BookPanel"/>
    <ui:Template name="HirePanel" src="project://database/Assets/Scripts/UI/Panels/Hiring/HirePanel.uxml?fileID=9197481963319205126&amp;guid=c1ede03fd56874438b8360843c981f3d&amp;type=3#HirePanel"/>
    <ui:Template name="MilestoneTracker" src="project://database/Assets/Scripts/UI/Panels/Milestone%20Tracker/MilestoneTracker.uxml?fileID=9197481963319205126&amp;guid=c986dfdbce2d64a2a9ee5099f22caa9e&amp;type=3#MilestoneTracker"/>
    <ui:Template name="PausePanel" src="project://database/Assets/Scripts/UI/Panels/Pause%20Menu/Pause_Panel.uxml?fileID=9197481963319205126&amp;guid=d86de3818b09844edb6036a25b22e634&amp;type=3#Pause_Panel"/>
    <ui:Template name="WorkshopPanel" src="project://database/Assets/Scripts/UI/Panels/Workshop/WorkshopPanel.uxml"/>
    <ui:Template name="ClassPickPanel" src="project://database/Assets/Scripts/UI/Panels/Class%20Pick/ClassPickPanel.uxml"/>
    <ui:Template name="DecoratePanel" src="project://database/Assets/Scripts/UI/Panels/Decorate/DecoratePanel.uxml"/>
    <ui:Template name="TransportPanel" src="project://database/Assets/Scripts/UI/Panels/Transport/TransportPanel.uxml"/>
    <ui:Template name="StarFanfare" src="project://database/Assets/Scripts/UI/Panels/Star%20Fanfare/StarFanfare.uxml"/>
    <ui:Template name="WelcomeBack" src="project://database/Assets/Scripts/UI/Panels/Welcome%20Back/WelcomeBack.uxml"/>
    <ui:Template name="TopNavigation" src="project://database/Assets/Scripts/UI/TopNavigation.uxml?fileID=9197481963319205126&amp;guid=ea5112a68ff84455992e270c7a46c49f&amp;type=3#TopNavigation"/>
    <Style src="project://database/Assets/Scripts/UI/MainUI.uss?fileID=7433441132597879392&amp;guid=4213a91c70ef441ea9b066247634b523&amp;type=3#MainUI"/>
    <Style src="project://database/Assets/Scripts/UI/Panels/Hiring/HirePanel.uss?fileID=7433441132597879392&amp;guid=624f2716701eb49f29adeb10fda31f63&amp;type=3#HirePanel"/>
    <Style src="project://database/Assets/Scripts/UI/GlobalVariables.uss?fileID=7433441132597879392&amp;guid=a78c87095b9cb4d12a022ef277e19da6&amp;type=3#GlobalVariables"/>
    <Style src="project://database/Assets/Scripts/UI/Components/Button.uss?fileID=7433441132597879392&amp;guid=ca85a2c69b8914d29a2cd1cd9d9d5556&amp;type=3#Button"/>
    <ui:VisualElement name="main-root" class="main-ui-root">
        <ui:Instance template="TopNavigation" name="TopNavigation"/>
        <ui:VisualElement name="body" class="game-view-area" style="flex-grow: 1;">
            <ui:Instance template="HirePanel" name="HirePanel" style="display: none;"/>
            <ui:Instance template="PausePanel" name="PausePanel" style="flex-grow: 1; display: none;"/>
            <ui:Instance template="BookPanel" name="BookPanel" style="flex-grow: 0; position: absolute; bottom: 0; top: 0; left: 0; right: 0; display: none;"/>
            <ui:Instance template="WorkshopPanel" name="WorkshopPanel" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
        </ui:VisualElement>
        <ui:Instance template="MilestoneTracker" name="MilestoneTracker" style="position: absolute; right: 16px; top: 129px;"/>
        <ui:Instance template="WelcomeBack" name="WelcomeBack" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none;"/>
        <!-- last child of main-root, so its dim backdrop covers the top nav and milestone tracker too -->
        <ui:Instance template="ClassPickPanel" name="ClassPickPanel" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
        <!-- guild-hall Decorate modal (click a decor slot); before StarFanfare so the fanfare draws on top -->
        <ui:Instance template="DecoratePanel" name="DecoratePanel" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
        <!-- dungeon-ladder Transport modal (click a ladder): Elevator ranks + Teleport Circle -->
        <ui:Instance template="TransportPanel" name="TransportPanel" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
        <!-- star fanfare draws over everything (book, HUD, tracker); never picks except its ribbon and cards -->
        <ui:Instance template="StarFanfare" name="StarFanfare" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
    </ui:VisualElement>
</ui:UXML>
