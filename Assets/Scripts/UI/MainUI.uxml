    <ui:VisualElement name="main-root" class="main-ui-root">
        <ui:Instance template="TopNavigation" name="TopNavigation"/>
        <ui:VisualElement name="body" class="game-view-area" style="flex-grow: 1;">
            <ui:Instance template="MilestoneTracker" name="MilestoneTracker" style="position: absolute; right: 0; top: 20%;"/>
