            <ui:Instance template="PausePanel" name="PausePanel" style="flex-grow: 1; display: none;"/>
            <ui:Instance template="BookPanel" name="BookPanel" style="flex-grow: 0; position: absolute; bottom: 0; top: 0; left: 0; right: 0; display: none;"/>
        </ui:VisualElement>
    </ui:VisualElement>
