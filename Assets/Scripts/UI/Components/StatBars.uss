/* ── Stat bars: 10 cells (cells built by CandidateUIMapper.PopulateBars; poster + roster detail) ── */
.bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 9px;
}

.bar-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.stat-damage { background-image: url("project://database/Assets/Sprites/Icons/Stats/stat_damage.png"); }
.stat-health { background-image: url("project://database/Assets/Sprites/Icons/Stats/stat_health.png"); }
.stat-aspd   { background-image: url("project://database/Assets/Sprites/Icons/Stats/stat_aspd.png"); }
.stat-reach  { background-image: url("project://database/Assets/Sprites/Icons/Stats/stat_reach.png"); }
.stat-speed  { background-image: url("project://database/Assets/Sprites/Icons/Stats/stat_speed.png"); }
.stat-carry  { background-image: url("project://database/Assets/Sprites/Icons/Stats/stat_carry.png"); }
.stat-pickup { background-image: url("project://database/Assets/Sprites/Icons/Stats/stat_pickup.png"); }

.bar {
    flex-grow: 1;
    flex-direction: row;
    height: 20px;
}

.bar-cell {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 3px;
    border-width: 2px;
    border-color: rgb(74, 50, 32);
    background-color: rgb(226, 210, 173);
}

.bar-cell--on { background-color: rgb(107, 68, 38); }
