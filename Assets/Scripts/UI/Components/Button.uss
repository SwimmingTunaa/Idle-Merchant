    scale: 1 1;
}

.btn-leading {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-right: var(--space-md);
    -unity-background-scale-mode: scale-to-fit;
}

.btn-trailing {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: var(--space-md);
}

.btn-label {
    -unity-text-align: middle-center;
}

.btn-trailing-text {
    -unity-font-style: bold;
}

.btn-coin {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-left: 2px;
    margin-bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Main%20UI/Copper%20Coin.png?fileID=2407117006326520345&guid=16798bfa02f8d44348f9fffdaf153786&type=3#Copper Coin_0");
}

.btn-sm {
    font-size: var(--font-size-body-md);
    padding: var(--space-xs) var(--space-sm);
}

.btn-lg {
    font-size: var(--font-size-body-xl);
    padding: var(--space-md) var(--space-lg);
}

.btn-ghost {
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text-secondary);
    border-width: 0;
    -unity-font-definition: var(--font-body);
    transition-property: background-color, color;
    transition-duration: var(--transition-fast);
}

.btn-ghost:hover {
    background-color: rgba(139, 90, 60, 0.15);
    color: var(--color-text-primary);
}

.btn-ghost:active {
    background-color: rgba(139, 90, 60, 0.3);
}

.btn-ghost:disabled {
    color: var(--color-disabled-text);
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
}

.btn-icon {
    width: 44px;
    height: 44px;
    padding: 0;
    background-image: url('project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/button-bg-white.png?fileID=3065250773223304532&guid=b53c1c774ce2645d58a85465c6a7375f&type=3#button-bg-white_0');
    -unity-slice-left: 5;
    -unity-slice-top: 5;
    -unity-slice-right: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 2px;
    -unity-background-image-tint-color: var(--color-secondary);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--color-text-primary);
    font-size: var(--text-lg);
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: var(--transition-fast);
}

.btn-icon:hover {
    scale: 1.05 1.05;
}

.btn-icon:active {
    scale: 0.95 0.95;
}

.btn-close {
    width: 40px;
    height: 40px;
    padding: 0;
    background-image: url('project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/button-bg-white.png?fileID=3065250773223304532&guid=b53c1c774ce2645d58a85465c6a7375f&type=3#button-bg-white_0');
    -unity-slice-left: 5;
    -unity-slice-top: 5;
    -unity-slice-right: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 2px;
    -unity-background-image-tint-color: var(--color-destructive);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--color-text-inverse);
    font-size: var(--text-lg);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: var(--transition-fast);
}

.btn-close:hover {
    -unity-background-image-tint-color: var(--color-destructive-hover);
    scale: 1.1 1.1;
}

.btn-close:active {
    -unity-background-image-tint-color: var(--color-destructive-active);
    scale: 0.9 0.9;
}
