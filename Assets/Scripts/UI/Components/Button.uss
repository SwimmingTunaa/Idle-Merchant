.btn-primary {
    -unity-background-image-tint-color: var(--color-primary);
}

.btn-primary:hover {
    -unity-background-image-tint-color: var(--color-primary-hover);
    scale: 1.02 1.02;
}

.btn-primary:active {
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/button-pressed.png?fileID=21300000&guid=0444a046c4fd441485acbb48ef4dacd8&type=3#button-pressed");
    -unity-background-image-tint-color: var(--color-primary-active);
    scale: 0.97 0.97;
}

.btn-secondary {
    -unity-background-image-tint-color: var(--color-secondary);
    color: var(--color-text-primary);
}

.btn-secondary:hover {
    -unity-background-image-tint-color: var(--color-secondary-hover);
    scale: 1.02 1.02;
}

.btn-secondary:active {
