.btn-primary {
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/button-bg.png?fileID=2800000&guid=a4602ed1337ac4e6d8fcfe2825be446c&type=3#button-bg");
    -unity-slice-left: 5;
    -unity-slice-top: 5;
    -unity-slice-right: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: var(--space-md) var(--space-md);
    font-size: var(--font-size-body-lg);
    color: var(--color-text-inverse);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: var(--transition-fast);
}

