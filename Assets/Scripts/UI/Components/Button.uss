.btn-primary {
    background-image: url("project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/button-raised.png?fileID=21300000&guid=35bc8f28e7a14dbe8d2152d953cc0fc7&type=3#button-raised");
    -unity-slice-left: 5;
    -unity-slice-top: 5;
    -unity-slice-right: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 13px var(--space-md) 19px var(--space-md);
    font-size: 36px;
    color: var(--color-text-inverse);
    -unity-text-align: middle-center;
    -unity-font-definition: var(--font-body);
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: var(--transition-fast);
}

