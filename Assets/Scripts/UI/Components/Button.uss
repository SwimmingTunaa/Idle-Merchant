.btn-primary {
    -unity-background-image-tint-color: var(--color-primary);
}

.btn-primary:hover {
    -unity-background-image-tint-color: var(--color-primary-hover);
    scale: 1.02 1.02;
}

.btn-primary:active {
    -unity-background-image-tint-color: var(--color-primary-active);
    scale: 0.97 0.97;
}

.btn-secondary {
    -unity-background-image-tint-color: var(--color-secondary);
    color: var(--color-text-primary);
}

.btn-secondary:hover {
    -unity-background-image-tint-color: var(--color-secondary-hover);
    scale: 1.02 1.02;
}

.btn-secondary:active {
    -unity-background-image-tint-color: var(--color-secondary-active);
    scale: 0.97 0.97;
}

.btn-success {
    -unity-background-image-tint-color: var(--color-success);
}

.btn-success:hover {
    -unity-background-image-tint-color: var(--color-success-hover);
    scale: 1.02 1.02;
}

.btn-success:active {
    -unity-background-image-tint-color: var(--color-success-active);
    scale: 0.97 0.97;
}

.btn-danger {
    -unity-background-image-tint-color: var(--color-destructive);
}

.btn-destructive {
    -unity-background-image-tint-color: var(--color-destructive);
}

.btn-danger:hover {
    -unity-background-image-tint-color: var(--color-destructive-hover);
    scale: 1.02 1.02;
}

.btn-destructive:hover {
    -unity-background-image-tint-color: var(--color-destructive-hover);
    scale: 1.02 1.02;
}

.btn-danger:active {
    -unity-background-image-tint-color: var(--color-destructive-active);
    scale: 0.97 0.97;
}

.btn-destructive:active {
    -unity-background-image-tint-color: var(--color-destructive-active);
    scale: 0.97 0.97;
}

.btn-disabled {
    -unity-background-image-tint-color: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    scale: 1 1;
}

.btn-primary:disabled {
    -unity-background-image-tint-color: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    scale: 1 1;
}

.btn-secondary:disabled {
    -unity-background-image-tint-color: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    scale: 1 1;
}

.btn-success:disabled {
    -unity-background-image-tint-color: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    scale: 1 1;
}

.btn-danger:disabled {
    -unity-background-image-tint-color: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    scale: 1 1;
}

.btn-destructive:disabled {
    -unity-background-image-tint-color: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    scale: 1 1;
}

.btn-leading {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-right: var(--space-md);
    -unity-background-scale-mode: scale-to-fit;
}

.btn-trailing {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: var(--space-md);
}

.btn-label {
    -unity-text-align: middle-center;
}

.btn-trailing-text {
    -unity-font-style: bold;
}

.btn-coin {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-left: var(--space-sm);
    -unity-background-scale-mode: scale-to-fit;
}

.btn-sm {
    font-size: var(--font-size-body-md);
    padding: var(--space-xs) var(--space-sm);
}

.btn-lg {
    font-size: var(--font-size-body-xl);
    padding: var(--space-md) var(--space-lg);
}

.btn-ghost {
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text-secondary);
    border-width: 0;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
    transition-property: background-color, color;
    transition-duration: var(--transition-fast);
}

.btn-ghost:hover {
    background-color: rgba(139, 90, 60, 0.15);
    color: var(--color-text-primary);
}

.btn-ghost:active {
    background-color: rgba(139, 90, 60, 0.3);
}

.btn-ghost:disabled {
    color: var(--color-disabled-text);
    background-color: rgba(0, 0, 0, 0);
}

.btn-icon {
    width: 44px;
    height: 44px;
    padding: 0;
    background-image: url('project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/button-bg-white.png?fileID=3065250773223304532&guid=b53c1c774ce2645d58a85465c6a7375f&type=3#button-bg-white_0');
    -unity-slice-left: 5;
    -unity-slice-top: 5;
    -unity-slice-right: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 2px;
    -unity-background-image-tint-color: var(--color-secondary);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--color-text-primary);
    font-size: var(--text-lg);
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: var(--transition-fast);
}

.btn-icon:hover {
    scale: 1.05 1.05;
}

.btn-icon:active {
    scale: 0.95 0.95;
}

.btn-close {
    width: 40px;
    height: 40px;
    padding: 0;
    background-image: url('project://database/Assets/Sprites/UI/Book%20UI/Content/Boxes/Dark/button-bg-white.png?fileID=3065250773223304532&guid=b53c1c774ce2645d58a85465c6a7375f&type=3#button-bg-white_0');
    -unity-slice-left: 5;
    -unity-slice-top: 5;
    -unity-slice-right: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 2px;
    -unity-background-image-tint-color: var(--color-destructive);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--color-text-inverse);
    font-size: var(--text-lg);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: var(--transition-fast);
}

.btn-close:hover {
    -unity-background-image-tint-color: var(--color-destructive-hover);
    scale: 1.1 1.1;
}

.btn-close:active {
    -unity-background-image-tint-color: var(--color-destructive-active);
    scale: 0.9 0.9;
}
