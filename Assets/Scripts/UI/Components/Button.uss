    scale: 0.97 0.97;
}

.btn-disabled {
    -unity-background-image-tint-color: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    scale: 1 1;
}

.btn-primary:disabled {
    -unity-background-image-tint-color: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    opacity: 1;
    scale: 1 1;
}

.btn-secondary:disabled {
