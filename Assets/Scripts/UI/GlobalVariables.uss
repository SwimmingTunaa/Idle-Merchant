:root {
    --color-bg-dark: rgb(101, 67, 33);
    --color-bg-medium: rgb(139, 90, 60);
    --color-bg-light: rgb(221, 211, 193);
    --color-bg-surface: rgb(250, 240, 220);
    --color-bg-overlay: rgba(20, 12, 5, 0.6);
    --color-text-primary: rgb(50, 30, 10);
    --color-text-secondary: rgb(88, 59, 33);
    --color-text-muted: rgb(170, 160, 140);
    --color-text-inverse: rgb(250, 240, 220);
    --color-text-link: rgb(180, 130, 50);
    --color-accent: rgb(255, 190, 97);
    --color-accent-hover: rgb(255, 210, 140);
    --color-accent-active: rgb(220, 160, 60);
    --color-success: rgb(100, 160, 80);
    --color-success-hover: rgb(120, 180, 100);
    --color-warning: rgb(220, 170, 50);
    --color-warning-hover: rgb(240, 190, 70);
    --color-destructive: rgb(180, 60, 50);
    --color-destructive-hover: rgb(200, 80, 70);
    --color-destructive-active: rgb(150, 45, 38);
    --color-disabled-bg: rgb(200, 190, 175);
    --color-disabled-text: rgb(170, 160, 140);
    --color-disabled-border: rgb(180, 170, 155);
    --color-border-dark: rgb(101, 67, 33);
    --color-border-medium: rgb(139, 90, 60);
    --color-border-light: rgb(200, 185, 160);
    --color-border-accent: rgb(255, 190, 97);
    --font-size-h1: 32px;
    --font-size-h2: 24px;
    --font-size-h3: 20px;
    --font-size-body: 16px;
    --font-size-small: 14px;
    --font-size-caption: 12px;
    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 16px;
    --space-lg: 24px;
    --space-xl: 32px;
    --space-xxl: 48px;
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 16px;
    --radius-pill: 999px;
    --border-thin: 1px;
    --border-medium: 2px;
    --border-thick: 4px;
    --border-frame: 6px;
    --transition-fast: 0.12s;
    --transition-normal: 0.2s;
    --transition-slow: 0.35s;
}

.text-h1 {
    font-size: var(--font-size-h1);
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
}

.text-h2 {
    font-size: var(--font-size-h2);
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
}

.text-h3 {
    font-size: var(--font-size-h3);
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
}

.label {
    font-size: var(--font-size-h2);
    color: var(--color-text-primary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.text-body {
    font-size: var(--font-size-body);
    color: var(--color-text-secondary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.text-small {
    font-size: var(--font-size-small);
    color: var(--color-text-secondary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.text-caption {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.text-h1-inverse {
    font-size: var(--font-size-h1);
    -unity-font-style: bold;
    color: var(--color-text-inverse);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
}

.text-h2-inverse {
    font-size: var(--font-size-h2);
    -unity-font-style: bold;
    color: var(--color-text-inverse);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
}

.text-body-inverse {
    font-size: var(--font-size-body);
    color: var(--color-text-inverse);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Salmon%20Typewriter%209%20Regular.ttf?fileID=12800000&guid=2c162277ddf0d4f9fa96298d0a4c7a84&type=3#Salmon Typewriter 9 Regular");
}

.margin-none {
    margin: 0;
}

.padding-xs {
    padding: var(--space-xs);
}

.padding-sm {
    padding: var(--space-sm);
}

.padding-md {
    padding: var(--space-md);
}

.padding-lg {
    padding: var(--space-lg);
}

.padding-xl {
    padding: var(--space-xl);
}

.padding-rect-sm {
    padding: var(--space-sm) var(--space-md);
}

.btn-primary {
    background-color: var(--color-accent);
    color: var(--color-text-primary);
    border-color: var(--color-border-dark);
    border-width: var(--border-medium);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-body);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Salmon%20Typewriter%209%20Regular.ttf?fileID=12800000&guid=2c162277ddf0d4f9fa96298d0a4c7a84&type=3#Salmon Typewriter 9 Regular");
    transition-property: background-color, scale;
    transition-duration: var(--transition-fast);
}

.btn-primary:hover {
    background-color: var(--color-accent-hover);
    scale: 1.02 1.02;
}

.btn-primary:active {
    background-color: var(--color-accent-active);
    scale: 0.98 0.98;
}

.btn-primary:disabled {
    background-color: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    border-color: var(--color-disabled-border);
    scale: 1 1;
}

.btn-secondary {
    background-color: var(--color-bg-surface);
    color: var(--color-text-primary);
    border-color: var(--color-border-medium);
    border-width: var(--border-medium);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-body);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Salmon%20Typewriter%209%20Regular.ttf?fileID=12800000&guid=2c162277ddf0d4f9fa96298d0a4c7a84&type=3#Salmon Typewriter 9 Regular");
    transition-property: background-color, border-color, scale;
    transition-duration: var(--transition-fast);
}

.btn-secondary:hover {
    background-color: var(--color-bg-light);
    border-color: var(--color-border-dark);
    scale: 1.02 1.02;
}

.btn-secondary:active {
    background-color: var(--color-bg-medium);
    color: var(--color-text-inverse);
    scale: 0.98 0.98;
}

.btn-secondary:disabled {
    background-color: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    border-color: var(--color-disabled-border);
    scale: 1 1;
}

.btn-destructive {
    background-color: var(--color-destructive);
    color: var(--color-text-inverse);
    border-color: rgb(140, 40, 30);
    border-width: var(--border-medium);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-body);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Salmon%20Typewriter%209%20Regular.ttf?fileID=12800000&guid=2c162277ddf0d4f9fa96298d0a4c7a84&type=3#Salmon Typewriter 9 Regular");
    transition-property: background-color, scale;
    transition-duration: var(--transition-fast);
}

.btn-destructive:hover {
    background-color: var(--color-destructive-hover);
    scale: 1.02 1.02;
}

.btn-destructive:active {
    background-color: var(--color-destructive-active);
    scale: 0.98 0.98;
}

.btn-destructive:disabled {
    background-color: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    border-color: var(--color-disabled-border);
    scale: 1 1;
}

.btn-ghost {
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text-secondary);
    border-width: 0;
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-body);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Salmon%20Typewriter%209%20Regular.ttf?fileID=12800000&guid=2c162277ddf0d4f9fa96298d0a4c7a84&type=3#Salmon Typewriter 9 Regular");
    transition-property: background-color, color;
    transition-duration: var(--transition-fast);
}

.btn-ghost:hover {
    background-color: rgba(139, 90, 60, 0.15);
    color: var(--color-text-primary);
}

.btn-ghost:active {
    background-color: rgba(139, 90, 60, 0.3);
}

.btn-ghost:disabled {
    color: var(--color-disabled-text);
    background-color: rgba(0, 0, 0, 0);
}

.btn-icon {
    width: 40px;
    height: 40px;
    background-color: rgba(101, 67, 33, 0.5);
    color: var(--color-text-inverse);
    border-width: 0;
    border-radius: var(--radius-sm);
    padding: 0;
    font-size: var(--font-size-h3);
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: var(--transition-fast);
}

.btn-icon:hover {
    background-color: rgba(101, 67, 33, 0.8);
}

.btn-icon:active {
    background-color: rgb(101, 67, 33);
}

.panel-frame {
    background-color: var(--color-bg-medium);
    border-color: var(--color-border-dark);
    border-width: var(--border-frame);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
}

.panel-surface {
    background-color: var(--color-bg-surface);
    border-color: var(--color-border-medium);
    border-width: var(--border-medium);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
}

.panel-inset {
    background-color: var(--color-bg-light);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
}

.panel-overlay {
    background-color: var(--color-bg-overlay);
    position: absolute;
    width: 100%;
    height: 100%;
}

.divider-horizontal {
    flex-shrink: 0;
    width: 100%;
    height: var(--border-medium);
    background-color: var(--color-border-light);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-sm);
}

.divider-vertical {
    flex-shrink: 0;
    height: 100%;
    width: var(--border-medium);
    background-color: var(--color-border-light);
    margin-left: var(--space-sm);
    margin-right: var(--space-sm);
}
