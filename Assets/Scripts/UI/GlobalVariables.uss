:root {
    /* ═════════ Primitives — mirrors Figma Primary/* and Blue/* ═════════
       These are the canonical colour swatches. Semantic tokens below
       should alias to these where possible. Update both Figma and this
       block together when the design system changes.
    ── */
    --primary-200: rgb(238, 225, 200);   /* #EEE1C8 — Figma Primary/200 */
    --primary-300: rgb(221, 211, 193);   /* #DDD3C1 — Figma Primary/300 */
    --primary-800: rgb(128, 75, 24);     /* #804B18 — Figma Primary/800 */

    --blue-200: rgb(169, 212, 239);      /* #A9D4EF — Figma Blue/200 */
    --blue-300: rgb(117, 180, 224);      /* #75B4E0 — Figma Blue/300 */
    --blue-400: rgb(88, 155, 210);       /* #589BD2 — Figma Blue/400 */
    --blue-500: rgb(59, 130, 196);       /* #3B82C4 — Figma Blue/500 */
    --blue-600: rgb(50, 111, 169);       /* #326FA9 — Figma Blue/600 */
    --blue-700: rgb(42, 93, 143);        /* #2A5D8F — Figma Blue/700 */
    --blue-800: rgb(28, 63, 99);         /* #1C3F63 — Figma Blue/800 */

    /* ═════════ Semantic colour tokens ═════════ */
    --color-bg-dark: rgb(101, 67, 33);
    --color-bg-medium: rgb(139, 90, 60);
    --color-bg-light: rgb(221, 211, 193);
    --color-bg-surface: rgb(250, 240, 220);
    --color-bg-overlay: rgba(20, 12, 5, 0.6);
    --color-text-primary: rgb(128, 75, 24);     /* #804B18 — Figma Text/Primary */
    --color-text-secondary: rgb(155, 112, 72);  /* #9B7048 — Figma Text/Secondary */
    --color-text-muted: rgb(170, 160, 140);     /* #AAA08C — Figma Text/Muted */
    --color-text-inverse: rgb(250, 240, 220);   /* #FAF0DC — Figma Text/Inverse */
    --color-text-link: rgb(180, 130, 50);       /* Unity-only */
    --color-exp: var(--blue-500);               /* mirrors Figma color-exp → Blue/500 */
    --color-accent: rgb(255, 190, 97);
    --color-accent-hover: rgb(255, 210, 140);
    --color-accent-active: rgb(220, 160, 60);
    --color-success: rgb(100, 160, 80);
    --color-success-hover: rgb(120, 180, 100);
    --color-warning: rgb(220, 170, 50);
    --color-warning-hover: rgb(240, 190, 70);
    --color-destructive: rgb(180, 60, 50);
    --color-destructive-hover: rgb(200, 80, 70);
    --color-destructive-active: rgb(150, 45, 38);
    --color-disabled-bg: rgb(200, 190, 175);
    --color-disabled-text: rgb(170, 160, 140);
    --color-disabled-border: rgb(180, 170, 155);
    --color-border-dark: rgb(101, 67, 33);
    --color-border-medium: rgb(139, 90, 60);
    --color-border-light: rgb(200, 185, 160);
    --color-border-accent: rgb(255, 190, 97);
    /* ── Numeric font scale ──────────────────────────────────────────
       NotJamBlkltr13 (headings)  pixel-perfect at: 13px, 26px
       BrightLinger   (body/UI)   pixel-perfect at: 16px, 32px
       Rule: use BrightLinger 16px for all readable labels/captions.
             use NotJam 26px for headings only. 13px is too small to read.
    ── */
    --text-2xs:  16px;   /* BrightLinger 1× — smallest readable size      */
    --text-xs:   16px;   /* BrightLinger 1×                                */
    --text-sm:   16px;   /* BrightLinger 1×                                */
    --text-base: 16px;   /* BrightLinger 1×                                */
    --text-lg:   26px;   /* NotJam 2×                                      */
    --text-xl:   26px;   /* NotJam 2×                                      */
    --text-2xl:  32px;   /* BrightLinger 2×                                */
    --text-3xl:  32px;
    --text-4xl:  32px;

    /* ── Semantic aliases ── */
    --font-size-caption: 16px;   /* BrightLinger 1× */
    --font-size-small:   16px;   /* BrightLinger 1× */
    --font-size-body:    16px;   /* BrightLinger 1× */
    --font-size-h3:      26px;   /* NotJam 2×       */
    --font-size-h2:      26px;   /* NotJam 2×       */
    --font-size-h1:      26px;   /* NotJam 2×       */

    /* ── Figma-aligned font sizes (mirrors FontSize/* in Figma) ──
       ⚠ Some Figma sizes aren't pixel-perfect multiples of the
       native font sizes — they may render slightly fuzzy in-engine.
       Prefer the Unity-native scale above for crisp pixel rendering.
    ── */
    --font-size-body-sm:     16px;   /* Figma Body/SM — pixel-perfect (BrightLinger 1×) */
    --font-size-body-md:     24px;   /* Figma Body/MD — NOT pixel-perfect */
    --font-size-body-lg:     32px;   /* Figma Body/LG — pixel-perfect (BrightLinger 2×) */
    --font-size-body-xl:     40px;   /* Figma Body/XL — NOT pixel-perfect */
    --font-size-heading-lg:  52px;   /* Figma Heading/LG — pixel-perfect (NotJam 4×) */
    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 16px;
    --space-lg: 24px;
    --space-xl: 32px;
    --space-xxl: 48px;
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 16px;
    --radius-pill: 999px;
    --border-thin: 1px;
    --border-medium: 2px;
    --border-thick: 4px;
    --border-frame: 6px;
    --transition-fast: 0.12s;
    --transition-normal: 0.2s;
    --transition-slow: 0.35s;
}

.text-h1 {
    font-size: var(--font-size-h1);
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
}

.text-h2 {
    font-size: var(--font-size-h2);
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
}

.text-h3 {
    font-size: var(--font-size-h3);
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
}

.label {
    font-size: var(--font-size-h2);
    color: var(--color-text-primary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.text-body {
    font-size: var(--font-size-body);
    color: var(--color-text-secondary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.text-small {
    font-size: var(--font-size-small);
    color: var(--color-text-secondary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.text-caption {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
}

.text-lg {
    font-size: var(--font-size-h2);
    color: var(--color-text-secondary);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/BrightLinger.ttf?fileID=12800000&guid=b42dfca3fffbe4c5e9a29a3cd1074f71&type=3#BrightLinger");
    -unity-font-style: normal;
}

.text-h1-inverse {
    font-size: var(--font-size-h1);
    -unity-font-style: bold;
    color: var(--color-text-inverse);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
}

.text-h2-inverse {
    font-size: var(--font-size-h2);
    -unity-font-style: bold;
    color: var(--color-text-inverse);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotJamBlkltr13.ttf?fileID=12800000&guid=bf0206d6060cb4ed89e74ae40ea01e22&type=3#NotJamBlkltr13");
}

.text-body-inverse {
    font-size: var(--font-size-body);
    color: var(--color-text-inverse);
}

.margin-none {
    margin: 0;
}

.padding-xs {
    padding: var(--space-xs);
}

.padding-sm {
    padding: var(--space-sm);
}

.padding-md {
    padding: var(--space-md);
}

.padding-lg {
    padding: var(--space-lg);
}

.padding-xl {
    padding: var(--space-xl);
}

.padding-rect-sm {
    padding: var(--space-sm) var(--space-md);
}

/* ── Buttons → see Assets/Scripts/UI/Components/Button.uss ─────── */

.panel-frame {
    background-color: var(--color-bg-medium);
    border-color: var(--color-border-dark);
    border-width: var(--border-frame);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
}

.panel-surface {
    background-color: var(--color-bg-surface);
    border-color: var(--color-border-medium);
    border-width: var(--border-medium);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
}

.panel-inset {
    background-color: var(--color-bg-light);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
}

.panel-overlay {
    background-color: var(--color-bg-overlay);
    position: absolute;
    width: 100%;
    height: 100%;
}

.divider-horizontal {
    flex-shrink: 0;
    width: 100%;
    height: var(--border-medium);
    background-color: var(--color-border-light);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-sm);
}

.divider-vertical {
    flex-shrink: 0;
    height: 100%;
    width: var(--border-medium);
    background-color: var(--color-border-light);
    margin-left: var(--space-sm);
    margin-right: var(--space-sm);
}
